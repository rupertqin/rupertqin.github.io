---
import BlogCard from "@/components/BlogCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Share from "@/components/Share.astro";
import config from "@/config/config.json";
import Disqus from "@/helpers/Disqus";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { slugSelector } from "@/lib/utils/languageParser";
import similarItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import ImageMod from "./components/ImageMod.astro";
const { default_language } = config.settings;

const COLLECTION_FOLDER = "blog";
const { post } = Astro.props;
let { lang } = Astro.params;

if (!lang) {
  lang = default_language;
}

const posts = await getSinglePage(COLLECTION_FOLDER, lang);
const similarPosts = similarItems(post, posts);
const { Content } = await render(post);
const { title, description, author, categories, image, date, tags } = post.data;
---

<article class="pt-12 md:pt-16">
  <div class="wrap">
    <div class="mx-auto max-w-[760px]">
      <p class="kicker">
        {
          categories.map((category: string, index: number) => (
            <>
              <a
                class="transition-colors duration-200 hover:text-ink-strong"
                href={slugSelector(`/categories/${slugify(category)}`, lang)}
              >
                {humanize(category)}
              </a>
              {index !== categories.length - 1 && " · "}
            </>
          ))
        }
        {date && <span class="text-placeholder"> · {dateFormat(date)}</span>}
      </p>

      <h1
        set:html={markdownify(title)}
        class="mt-5 text-[clamp(28px,4.2vw,48px)] font-medium leading-[1.14] tracking-[-0.025em] text-ink-strong"
      />

      <div class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-ink-muted">
        <a
          href={slugSelector(`/authors/${slugify(author)}`, lang)}
          class="transition-colors duration-200 hover:text-ink-strong"
        >
          {humanize(author)}
        </a>
        <span class="text-placeholder">·</span>
        <span>{date ? dateFormat(date) : "—"}</span>
      </div>

      {
        image && (
          <ImageMod
            src={image}
            height={500}
            width={1200}
            alt={title}
            class="mt-10 aspect-[16/9] w-full rounded-[14px] object-cover"
            format="webp"
            fit="cover"
          />
        )
      }

      <div class="content mt-12">
        <Content />
      </div>

      <div class="mt-14 flex flex-col gap-6 border-t border-line pt-8 md:flex-row md:items-center md:justify-between">
        <div class="flex flex-wrap items-center gap-2">
          {
            tags.map((tag: string) => (
              <a
                class="rounded-full border border-line px-3 py-1.5 text-[12.5px] text-ink-muted transition-colors duration-200 hover:border-line-strong hover:text-ink-strong"
                href={slugSelector(`/tags/${slugify(tag)}`, lang)}
              >
                #{humanize(tag)}
              </a>
            ))
          }
        </div>
        <div class="flex items-center gap-3">
          <span class="meta">Share</span>
          <Share className="social-icons" title={title} description={description} slug={post.id} />
        </div>
      </div>

      <Disqus className="mt-16" client:only="react" />
    </div>
  </div>

  <!-- Related posts -->
  <div class="band mt-16">
    <div class="wrap">
      <SectionHeader eyebrow={lang === "en" ? "Keep reading" : "继续阅读"} title={lang === "en" ? "Related posts" : "相关文章"}>
        <div class="mt-12 grid gap-10 md:grid-cols-3">
          {similarPosts.map((post) => <BlogCard data={post} />)}
        </div>
      </SectionHeader>
    </div>
  </div>
</article>
