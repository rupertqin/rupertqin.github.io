---
import BlogCard from "@/components/BlogCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Share from "@/components/Share.astro";
import config from "@/config/config.json";
import Disqus from "@/helpers/Disqus";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { slugSelector } from "@/lib/utils/languageParser";
import similarItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import ImageMod from "./components/ImageMod.astro";
const { default_language } = config.settings;

const COLLECTION_FOLDER = "blog";
const { post } = Astro.props;
let { lang } = Astro.params;

if (!lang) {
  lang = default_language;
}

const posts = await getSinglePage(
  COLLECTION_FOLDER,
  lang
);
const similarPosts = similarItems(post, posts);
const { Content } = await render(post);
const { title, description, author, categories, image, date, tags } = post.data;
---

<section class="section-sm pt-10">
  <div class="container">
    <div class="row justify-center">
      <article class="lg:col-9">
        {
          image && (
            <figure class="plate mb-10">
              <div class="plate__head">
                <span class="flex min-w-0 items-baseline gap-2.5">
                  <span class="plate__fig">FIG.C1</span>
                  <span class="plate__title">COVER</span>
                </span>
                <span class="plate__scale">Scale 1:1</span>
              </div>
              <div class="plate__body aspect-[16/9]">
                <ImageMod
                  src={image}
                  height={500}
                  width={1200}
                  alt={title}
                  class="h-full w-full object-cover"
                  format="webp"
                  fit="cover"
                />
              </div>
              <figcaption class="plate__foot">
                <span class="plate__caption">{title}</span>
                <span class="plate__scale">FIG.C1</span>
              </figcaption>
            </figure>
          )
        }

        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">
          {date && <span>{dateFormat(date)}</span>}
          {
            categories.map((category: string, index: number) => (
              <>
                <span class="inline-block h-2.5 w-px bg-line-strong" aria-hidden="true" />
                <a
                  class="transition-colors duration-200 hover:text-ink"
                  href={slugSelector(`/categories/${slugify(category)}`, lang)}
                >
                  {humanize(category)}
                  {index !== categories.length - 1 && ","}
                </a>
              </>
            ))
          }
        </div>

        <h1
          set:html={markdownify(title)}
          class="mt-4 text-[clamp(26px,3.6vw,40px)] font-semibold leading-[1.2] tracking-[-0.025em] text-ink"
        />

        <div class="dim mt-6">
          <span class="dim__value">type measure</span>
        </div>

        <div class="mt-5 flex items-center justify-between gap-4 border-y border-line py-3.5">
          <a
            href={slugSelector(`/authors/${slugify(author)}`, lang)}
            class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-sub transition-colors duration-200 hover:text-ink"
          >
            Drawn by / {humanize(author)}
          </a>
          <span class="sheet-meta hidden sm:inline-flex">
            <span>{date ? dateFormat(date) : "Undated"}</span>
            <i class="sheet-meta__dot"></i>
            <span>Sheet 01</span>
          </span>
        </div>

        <div class="content mt-10">
          <Content />
        </div>

        <div class="mt-12 flex flex-col gap-6 border-t border-line pt-8 md:flex-row md:items-center md:justify-between">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">Tags</span>
            {
              tags.map((tag: string) => (
                <a class="tech-tag" href={slugSelector(`/tags/${slugify(tag)}`, lang)}>
                  {humanize(tag)}
                </a>
              ))
            }
          </div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">Share</span>
            <Share
              className="social-icons"
              title={title}
              description={description}
              slug={post.id}
            />
          </div>
        </div>

        <Disqus className="mt-16" client:only="react" />
      </article>
    </div>

    <!-- Related posts -->
    <div class="mt-20 border-t border-line pt-14">
      <SectionHeader
        index="05"
        eyebrow="Index"
        title="Related Posts"
        note={`${String(similarPosts.length).padStart(2, "0")} records`}
        fig="05"
        sheet="06"
        class="mb-10"
      />
      <div class="row justify-center">
        {
          similarPosts.map((post) => (
            <div class="lg:col-4 md:col-6 mb-10">
              <BlogCard data={post} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
