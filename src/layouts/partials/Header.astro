---
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import LanguageSwitcher from "@/helpers/LanguageSwitcher";
import config from "@/config/config.json";
import { getLangFromUrl, getTranslations, slugSelector } from "@/lib/utils/languageParser";
import { IoSearch } from "react-icons/io5";

const lang = getLangFromUrl(Astro.url);
const menu = await getTranslations(lang);
const { pathname } = Astro.url;
const siteName = config.site.title || "秦项科技";
const logo = config.site.logo_dark || "/images/logo.svg";
---

<header class="sticky top-0 z-50 bg-white dark:bg-gray-900 shadow-sm">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <a href={slugSelector("/", lang)} class="flex items-center">
          <img src={logo} alt="Logo" class="w-10 h-10 mr-2" />
          <span class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-600">
            {siteName}
          </span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center h-16 space-x-2">
        {menu?.main?.map((item: any) => {
          const normalizedPath = pathname.replace(/\/$/, "");
          const itemUrl = slugSelector(item.url, lang);
          const isSelected = item.url && item.url !== "" ? normalizedPath === itemUrl.replace(/\/$/, "") : false;
          const isParentSelected = item.hasChildren && item.children?.some((child: any) => {
            if (!child.url) return false;
            const childNorm = slugSelector(child.url, lang).replace(/\/$/, "");
            return normalizedPath === childNorm || normalizedPath.startsWith(childNorm + "/");
          });
          return item.hasChildren ? (
            <div class="nav-dropdown group">
              <span class={`nav-dropdown-label${isParentSelected ? " active" : ""}`}>
                {item.name}
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
                </svg>
              </span>
              <div class="nav-dropdown-list">
                {item.children?.map((child: any) => {
                  const childUrl = slugSelector(child.url, lang);
                  const isChildSelected = normalizedPath === childUrl.replace(/\/$/, "") || normalizedPath.startsWith(childUrl.replace(/\/$/, "") + "/");
                  return (
                    <a href={childUrl} class={`nav-dropdown-link${isChildSelected ? " active" : ""}`}>
                      {child.name}
                    </a>
                  );
                })}
              </div>
            </div>
          ) : (
            <a href={itemUrl} class={`nav-link${isSelected ? " active" : ""}`}>
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Right side buttons -->
      <div class="flex items-center space-x-4">
        <!-- Search button -->
        {config.settings.search && (
          <button
            class="text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 text-xl flex items-center"
            aria-label="search"
            data-search-trigger
          >
            <IoSearch />
          </button>
        )}
        <!-- Language switcher -->
        <LanguageSwitcher client:load lang={lang} pathname={pathname} />
        <!-- Theme switcher -->
        <ThemeSwitcher className="text-gray-700 dark:text-gray-300" />
        <!-- Mobile menu button -->
        <button
          id="mobile-menu-button"
          class="md:hidden text-gray-700 dark:text-gray-300 p-2 focus:outline-none flex items-center"
          aria-label="Menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden fixed left-0 right-0 top-16 z-50 bg-white dark:bg-gray-900 shadow-lg">
      <div class="px-4 py-4 space-y-3 max-h-[80vh] overflow-y-auto">
        {menu?.main?.map((item: any) => {
          const normalizedPath = pathname.replace(/\/$/, "");
          const isSelected = item.url && item.url !== "" ? normalizedPath === slugSelector(item.url, lang).replace(/\/$/, "") : false;
          const isParentSelected = item.hasChildren && item.children?.some((child: any) => {
            if (!child.url) return false;
            const childNorm = slugSelector(child.url, lang).replace(/\/$/, "");
            return normalizedPath === childNorm || normalizedPath.startsWith(childNorm + "/");
          });
          return item.hasChildren ? (
            <>
              <div class={`text-gray-700 dark:text-gray-300 font-medium px-3 py-2${isParentSelected ? " text-blue-600 dark:text-blue-400" : ""}`}>
                {item.name}
              </div>
              {item.children?.map((child: any) => {
                const childUrl = slugSelector(child.url, lang);
                const isChildSelected = normalizedPath === childUrl.replace(/\/$/, "") || normalizedPath.startsWith(childUrl.replace(/\/$/, "") + "/");
                return (
                  <a href={childUrl} class={`block px-6 py-2 rounded-md text-base font-medium text-gray-600 hover:text-blue-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-blue-400 dark:hover:bg-gray-800${isChildSelected ? " text-blue-600 dark:text-blue-400" : ""}`}>
                    {child.name}
                  </a>
                );
              })}
            </>
          ) : (
            <a href={slugSelector(item.url, lang)} class={`block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:text-blue-400 dark:hover:bg-gray-800${isSelected ? " text-blue-600 dark:text-blue-400" : ""}`}>
              {item.name}
            </a>
          );
        })}
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        if (!mobileMenu.classList.contains('hidden')) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      });

      document.addEventListener('click', (e) => {
        if (
          !mobileMenu.classList.contains('hidden') &&
          !mobileMenu.contains(e.target as Node) &&
          !mobileMenuButton.contains(e.target as Node)
        ) {
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = '';
        }
      });
    }
  });
</script>
