---
import LanguageSwitcher from "@/helpers/LanguageSwitcher";
import config from "@/config/config.json";
import { getLangFromUrl, getTranslations, slugSelector } from "@/lib/utils/languageParser";
import { IoSearch } from "react-icons/io5";

const lang = getLangFromUrl(Astro.url);
const menu = await getTranslations(lang);
const { pathname } = Astro.url;
const siteName = config.site.title || "秦项科技";
const logo = config.site.logo || "/images/logo.svg";
---

<header class="sticky top-0 z-50 bg-background/90 backdrop-blur-md">
  <!-- sheet meta: the plate's own paperwork, desktop only -->
  <div class="hidden border-b border-line lg:block">
    <div class="container flex h-7 items-center justify-between">
      <span class="sheet-meta">
        {siteName}
        <i class="sheet-meta__dot"></i>
        <span>TECHNICAL PLATE</span>
      </span>
      <span class="sheet-meta">
        <span>SCALE 1:1</span>
        <i class="sheet-meta__dot"></i>
        <span>SHEET 01</span>
        <i class="sheet-meta__dot"></i>
        <span>REV 2026.11</span>
      </span>
    </div>
  </div>

  <div class="container">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center">
        <a href={slugSelector("/", lang)} class="flex items-center gap-2.5">
          <span class="logo-stamp">
            <img src={logo} alt="Logo" class="logo-mark h-8 w-8" />
          </span>
          <span class="text-[17px] font-semibold leading-none tracking-[-0.01em] text-ink">
            {siteName}
          </span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden h-16 items-center gap-0.5 lg:flex">
        {menu?.main?.map((item: any) => {
          const normalizedPath = pathname.replace(/\/$/, "");
          const itemUrl = slugSelector(item.url, lang);
          const isSelected = item.url && item.url !== "" ? normalizedPath === itemUrl.replace(/\/$/, "") : false;
          const isParentSelected = item.hasChildren && item.children?.some((child: any) => {
            if (!child.url) return false;
            const childNorm = slugSelector(child.url, lang).replace(/\/$/, "");
            return normalizedPath === childNorm || normalizedPath.startsWith(childNorm + "/");
          });
          return item.hasChildren ? (
            <div class="nav-dropdown group">
              <span class={`nav-dropdown-label${isParentSelected ? " active" : ""}`}>
                {item.name}
                <svg class="h-3 w-3 opacity-60" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 20 20">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 7.5 10 12.5 15 7.5" />
                </svg>
              </span>
              <div class="nav-dropdown-list">
                {item.children?.map((child: any) => {
                  const childUrl = slugSelector(child.url, lang);
                  const isChildSelected = normalizedPath === childUrl.replace(/\/$/, "") || normalizedPath.startsWith(childUrl.replace(/\/$/, "") + "/");
                  return (
                    <a href={childUrl} class={`nav-dropdown-link${isChildSelected ? " active" : ""}`}>
                      {child.name}
                    </a>
                  );
                })}
              </div>
            </div>
          ) : (
            <a href={itemUrl} class={`nav-link${isSelected ? " active" : ""}`}>
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Right side buttons -->
      <div class="flex items-center gap-3">
        <!-- Search button -->
        {config.settings.search && (
          <button class="icon-btn" aria-label="search" data-search-trigger>
            <IoSearch className="text-[17px]" />
          </button>
        )}
        <!-- Language switcher -->
        <LanguageSwitcher client:load lang={lang} pathname={pathname} />
        <!-- Mobile menu button -->
        <button
          id="mobile-menu-button"
          class="icon-btn lg:hidden"
          aria-label="Menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="fixed left-0 right-0 top-[68px] z-50 hidden max-h-[calc(100vh-4.25rem)] overflow-y-auto border-b border-line bg-background lg:hidden">
      <div class="container py-2">
        {menu?.main?.map((item: any) => {
          const normalizedPath = pathname.replace(/\/$/, "");
          const isSelected = item.url && item.url !== "" ? normalizedPath === slugSelector(item.url, lang).replace(/\/$/, "") : false;
          const isParentSelected = item.hasChildren && item.children?.some((child: any) => {
            if (!child.url) return false;
            const childNorm = slugSelector(child.url, lang).replace(/\/$/, "");
            return normalizedPath === childNorm || normalizedPath.startsWith(childNorm + "/");
          });
          return item.hasChildren ? (
            <div class="border-b border-line py-1 last:border-0">
              <div class={`px-1 py-3 font-mono text-[11px] uppercase tracking-[0.12em] ${isParentSelected ? "text-ink" : "text-ink-muted"}`}>
                {item.name}
              </div>
              {item.children?.map((child: any) => {
                const childUrl = slugSelector(child.url, lang);
                const isChildSelected = normalizedPath === childUrl.replace(/\/$/, "") || normalizedPath.startsWith(childUrl.replace(/\/$/, "") + "/");
                return (
                  <a href={childUrl} class={`block rounded-[4px] px-1 py-2.5 text-[15px] transition-colors duration-150 ${isChildSelected ? "text-ink" : "text-ink-sub hover:text-ink"}`}>
                    {child.name}
                  </a>
                );
              })}
            </div>
          ) : (
            <a href={slugSelector(item.url, lang)} class={`flex items-center justify-between border-b border-line px-1 py-3.5 text-[15px] transition-colors duration-150 last:border-0 ${isSelected ? "text-ink" : "text-ink-sub hover:text-ink"}`}>
              {item.name}
              <span class="font-mono text-[11px] text-ink-muted">→</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <!-- the double rule that closes every drawing's header -->
  <div class="rule-pair" aria-hidden="true"></div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        if (!mobileMenu.classList.contains('hidden')) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      });

      document.addEventListener('click', (e) => {
        if (
          !mobileMenu.classList.contains('hidden') &&
          !mobileMenu.contains(e.target as Node) &&
          !mobileMenuButton.contains(e.target as Node)
        ) {
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = '';
        }
      });
    }
  });
</script>
