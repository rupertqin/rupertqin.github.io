---
import config from "@/config/config.json";
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";

const lang = getLangFromUrl(Astro.url);
const siteName = config.site.title || "秦项科技";
const logo = config.site.logo || "/images/logo.svg";
const gitHash = import.meta.env.PUBLIC_GIT_HASH || "";
const beian = config.params.beian || "";
---

<footer class="mt-24 border-t border-line bg-background">
  <div class="container py-16">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-4">
      <!-- Product Column -->
      <div>
        <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">产品</h3>
        <ul class="space-y-2.5">
          <li>
            <a href={slugSelector("/psychoanalytic", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              心理分析
            </a>
          </li>
          <li>
            <a href={slugSelector("/stock", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              股票分析
            </a>
          </li>
        </ul>
      </div>

      <!-- Solutions Column -->
      <div>
        <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">解决方案</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              企业数字化转型
            </a>
          </li>
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              人工智能应用
            </a>
          </li>
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              数据分析服务
            </a>
          </li>
        </ul>
      </div>

      <!-- Resources Column -->
      <div>
        <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">资源</h3>
        <ul class="space-y-2.5">
          <li>
            <a href={slugSelector("/blog", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              博客
            </a>
          </li>
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              文档中心
            </a>
          </li>
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              常见问题
            </a>
          </li>
        </ul>
      </div>

      <!-- Company Column -->
      <div>
        <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">公司</h3>
        <ul class="space-y-2.5">
          <li>
            <a href={slugSelector("/about", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              关于我们
            </a>
          </li>
          <li>
            <a href={slugSelector("/contact", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue">
              联系我们
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-14 flex flex-col gap-4 border-t border-line pt-8 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-2.5">
        <img src={logo} alt="Logo" class="h-7 w-7" />
        <span class="text-[15px] font-semibold leading-none tracking-[-0.01em] text-ink">
          {siteName}
        </span>
      </div>
      <div class="flex flex-col gap-1 md:items-end">
        <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-ink-muted">
          &copy; {new Date().getFullYear()} {siteName}
          {beian && (
            <a href="https://beian.miit.gov.cn/" target="_blank" class="ml-2 text-ink-muted transition-colors duration-200 hover:text-ink">
              {beian}
            </a>
          )}
        </p>
        {gitHash && (
          <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-ink-muted">Build: {gitHash}</p>
        )}
      </div>
    </div>
  </div>
</footer>
