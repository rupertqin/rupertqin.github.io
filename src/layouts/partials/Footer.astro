---
import config from "@/config/config.json";
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";

const lang = getLangFromUrl(Astro.url);
const siteName = config.site.title || "秦项科技";
const logo = config.site.logo || "/images/logo.svg";
const gitHash = import.meta.env.PUBLIC_GIT_HASH || "";
const beian = config.params.beian || "";

const columns = [
  {
    title: "产品",
    links: [
      { name: "心理分析", url: slugSelector("/psychoanalytic", lang) },
      { name: "股票分析", url: slugSelector("/stock", lang) },
    ],
  },
  {
    title: "解决方案",
    links: [
      { name: "企业数字化转型", url: "#" },
      { name: "人工智能应用", url: "#" },
      { name: "数据分析服务", url: "#" },
    ],
  },
  {
    title: "资源",
    links: [
      { name: "博客", url: slugSelector("/blog", lang) },
      { name: "文档中心", url: "#" },
      { name: "常见问题", url: "#" },
    ],
  },
  {
    title: "公司",
    links: [
      { name: "关于我们", url: slugSelector("/about", lang) },
      { name: "联系我们", url: slugSelector("/contact", lang) },
    ],
  },
];
---

<footer class="border-t border-line">
  <div class="wrap py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <a href={slugSelector("/", lang)} class="flex items-center gap-2.5">
          <img src={logo} alt="Logo" class="logo-mark h-7 w-7" />
          <span class="text-[15px] font-medium leading-none tracking-[-0.01em] text-ink-strong">
            {siteName}
          </span>
        </a>
        <p class="mt-4 max-w-[280px] text-[14px] leading-[1.65] text-ink-muted">
          秦项科技 · 专注于人工智能与科技创新。
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 md:col-span-8">
        {
          columns.map((column) => (
            <div>
              <h3 class="text-[13px] text-ink-strong">{column.title}</h3>
              <ul class="mt-4 space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.url}
                      class="text-[13.5px] text-ink-muted transition-colors duration-200 hover:text-ink-strong"
                    >
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-3 border-t border-line pt-6 text-[12.5px] text-ink-muted md:flex-row md:items-center md:justify-between"
    >
      <span>
        &copy; {new Date().getFullYear()} {siteName}
        {
          beian && (
            <a
              href="https://beian.miit.gov.cn/"
              target="_blank"
              class="ml-2 transition-colors duration-200 hover:text-ink-strong"
            >
              {beian}
            </a>
          )
        }
      </span>
      {gitHash && <span class="text-placeholder">build {gitHash}</span>}
    </div>
  </div>
</footer>
