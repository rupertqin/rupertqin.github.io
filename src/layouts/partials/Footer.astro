---
import config from "@/config/config.json";
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";

const lang = getLangFromUrl(Astro.url);
const siteName = config.site.title || "秦项科技";
const logo = config.site.logo || "/images/logo.svg";
const gitHash = import.meta.env.PUBLIC_GIT_HASH || "";
const beian = config.params.beian || "";
---

<footer class="mt-24 border-t border-line bg-background">
  <div class="container py-16">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-4">
      <!-- Product Column -->
      <div>
        <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">产品</h3>
        <ul class="space-y-2.5">
          <li>
            <a href={slugSelector("/psychoanalytic", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              心理分析
            </a>
          </li>
          <li>
            <a href={slugSelector("/stock", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              股票分析
            </a>
          </li>
        </ul>
      </div>

      <!-- Solutions Column -->
      <div>
        <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">解决方案</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              企业数字化转型
            </a>
          </li>
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              人工智能应用
            </a>
          </li>
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              数据分析服务
            </a>
          </li>
        </ul>
      </div>

      <!-- Resources Column -->
      <div>
        <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">资源</h3>
        <ul class="space-y-2.5">
          <li>
            <a href={slugSelector("/blog", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              博客
            </a>
          </li>
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              文档中心
            </a>
          </li>
          <li>
            <a href="#" class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              常见问题
            </a>
          </li>
        </ul>
      </div>

      <!-- Company Column -->
      <div>
        <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">公司</h3>
        <ul class="space-y-2.5">
          <li>
            <a href={slugSelector("/about", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              关于我们
            </a>
          </li>
          <li>
            <a href={slugSelector("/contact", lang)} class="text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink">
              联系我们
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Title block — the drawing's own paperwork -->
    <div class="mt-14">
      <div
        class="mb-3 flex items-center justify-between gap-6 font-mono text-[9.5px] uppercase tracking-[0.16em] text-placeholder"
      >
        <span>END OF DRAWING</span>
        <span>QINXIANG / TITLE BLOCK</span>
      </div>

      <div class="titleblock">
        <div class="titleblock__cell">
          <span class="titleblock__key">Drawn by</span>
          <span class="titleblock__val">{siteName}</span>
        </div>
        <div class="titleblock__cell">
          <span class="titleblock__key">Scale</span>
          <span class="titleblock__val">1:1</span>
        </div>
        <div class="titleblock__cell">
          <span class="titleblock__key">Sheet</span>
          <span class="titleblock__val">01 / 01</span>
        </div>
        <div class="titleblock__cell">
          <span class="titleblock__key">Rev</span>
          <span class="titleblock__val">{gitHash || "2026.11"}</span>
        </div>
      </div>

      <div
        class="flex flex-col gap-3 border-x border-b border-line px-3 py-3 md:flex-row md:items-center md:justify-between"
      >
        <div class="flex items-center gap-2.5">
          <img src={logo} alt="Logo" class="logo-mark h-6 w-6" />
          <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-ink-muted">
            &copy; {new Date().getFullYear()} {siteName}
            {beian && (
              <a
                href="https://beian.miit.gov.cn/"
                target="_blank"
                class="ml-2 text-ink-muted transition-colors duration-200 hover:text-ink"
              >
                {beian}
              </a>
            )}
          </span>
        </div>
        <span class="sheet-meta">
          <span>All rights reserved</span>
          {gitHash && (
            <>
              <i class="sheet-meta__dot"></i>
              <span>build {gitHash}</span>
            </>
          )}
        </span>
      </div>
    </div>
  </div>
</footer>
