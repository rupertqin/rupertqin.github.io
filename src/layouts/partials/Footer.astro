---
import config from "@/config/config.json";
import { getLangFromUrl, getTranslations, slugSelector } from "@/lib/utils/languageParser";
import { markdownify } from "@/lib/utils/textConverter";

const lang = getLangFromUrl(Astro.url);
const menu = await getTranslations(lang);
const siteName = config.site.title || "秦项科技";
const logo = config.site.logo_dark || "/images/logo.svg";
const gitHash = import.meta.env.PUBLIC_GIT_HASH || "";
const beian = config.params.beian || "";

let footer: any = [];
if (menu) {
  footer = menu.footer;
}
---

<footer class="bg-gray-100 dark:bg-gray-800 py-12 mt-16">
  <div class="container mx-auto px-4">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Product Column -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200">产品</h3>
        <ul class="space-y-2">
          <li>
            <a href={slugSelector("/mbti-test", lang)} class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              MBTI 测试
            </a>
          </li>
          <li>
            <a href={slugSelector("/cognitive-functions-table", lang)} class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              认知功能
            </a>
          </li>
          <li>
            <a href={slugSelector("/stock", lang)} class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              股票分析
            </a>
          </li>
        </ul>
      </div>

      <!-- Solutions Column -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200">解决方案</h3>
        <ul class="space-y-2">
          <li>
            <a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              企业数字化转型
            </a>
          </li>
          <li>
            <a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              人工智能应用
            </a>
          </li>
          <li>
            <a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              数据分析服务
            </a>
          </li>
        </ul>
      </div>

      <!-- Resources Column -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200">资源</h3>
        <ul class="space-y-2">
          <li>
            <a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              文档中心
            </a>
          </li>
          <li>
            <a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              API 参考
            </a>
          </li>
          <li>
            <a href="#" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              常见问题
            </a>
          </li>
        </ul>
      </div>

      <!-- Company Column -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-200">公司</h3>
        <ul class="space-y-2">
          <li>
            <a href={slugSelector("/about", lang)} class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              关于我们
            </a>
          </li>
          <li>
            <a href={slugSelector("/contact", lang)} class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              联系我们
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-200 dark:border-gray-700 pt-8 text-center">
      <div class="flex justify-center items-center mb-4">
        <img src={logo} alt="Logo" class="w-10 h-10 mr-2" />
        <span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-600">
          {siteName}
        </span>
      </div>
      <p class="text-gray-600 dark:text-gray-400">
        &copy; {new Date().getFullYear()} {siteName}
        {beian && (
          <span class="ml-2">
            <a href="https://beian.miit.gov.cn/" target="_blank" class="text-gray-600 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
              {beian}
            </a>
          </span>
        )}
      </p>
      {gitHash && (
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-500">Build: {gitHash}</p>
      )}
    </div>
  </div>
</footer>
