---
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";

const { tags, categories, allCategories } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<div class="lg:col-4">
  <!-- categories -->
  <div class="mb-10">
    <h5 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">
      Categories
    </h5>
    <ul class="border-t border-line">
      {
        categories.map((category: any) => {
          const count = allCategories.filter(
            (c: any) => c === category
          ).length;
          return (
            <li>
              <a
                class="flex items-baseline justify-between border-b border-line py-2.5 text-[14px] text-ink-sub transition-colors duration-200 hover:text-blue"
                href={slugSelector(`/categories/${category}`, lang)}
              >
                <span>{humanize(category)}</span>
                <span class="font-mono text-[11px] tabular-nums text-ink-muted">
                  {String(count).padStart(2, "0")}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- tags -->
  <div class="mb-10">
    <h5 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">
      Tags
    </h5>
    <ul class="flex flex-wrap gap-2">
      {
        tags.map((tag: any) => {
          return (
            <li>
              <a
                class="tech-tag"
                href={slugSelector(`/tags/${tag}`, lang)}
              >
                {humanize(tag)}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>
