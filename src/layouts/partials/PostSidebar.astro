---
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";

const { tags, categories, allCategories } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<div class="lg:col-4">
  <div class="mb-10">
    <div class="flex items-baseline justify-between">
      <h3 class="text-[13px] font-medium text-ink-strong">分类</h3>
      <span class="text-[12px] text-ink-muted">{String(categories.length).padStart(2, "0")}</span>
    </div>
    <ul class="mt-3 border-t border-line">
      {
        categories.map((category: any) => {
          const count = allCategories.filter((c: any) => c === category).length;
          return (
            <li>
              <a
                class="flex items-baseline justify-between border-b border-line py-2.5 text-[13.5px] text-ink-sub transition-colors duration-200 hover:text-ink-strong"
                href={slugSelector(`/categories/${category}`, lang)}
              >
                <span>{humanize(category)}</span>
                <span class="text-[12px] tabular-nums text-ink-muted">
                  {String(count).padStart(2, "0")}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="mb-10">
    <div class="flex items-baseline justify-between">
      <h3 class="text-[13px] font-medium text-ink-strong">标签</h3>
      <span class="text-[12px] text-ink-muted">{String(tags.length).padStart(2, "0")}</span>
    </div>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        tags.map((tag: any) => (
          <li>
            <a
              class="inline-flex rounded-full border border-line px-3 py-1.5 text-[12.5px] text-ink-muted transition-colors duration-200 hover:border-line-strong hover:text-ink-strong"
              href={slugSelector(`/tags/${tag}`, lang)}
            >
              #{humanize(tag)}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
