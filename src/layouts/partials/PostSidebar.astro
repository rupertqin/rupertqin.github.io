---
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";

const { tags, categories, allCategories } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<div class="lg:col-4">
  <!-- categories — a register with counts, closed by a rule -->
  <div class="callout mb-8">
    <div class="flex items-center justify-between border-b border-line pb-3">
      <span class="eyebrow">Categories</span>
      <span class="sheet-meta">{String(categories.length).padStart(2, "0")}</span>
    </div>
    <ul class="mt-1">
      {
        categories.map((category: any) => {
          const count = allCategories.filter(
            (c: any) => c === category
          ).length;
          return (
            <li>
              <a
                class="flex items-baseline justify-between border-b border-line py-2.5 text-[14px] text-ink-sub transition-colors duration-200 hover:text-ink"
                href={slugSelector(`/categories/${category}`, lang)}
              >
                <span>{humanize(category)}</span>
                <span class="font-mono text-[11px] tabular-nums text-ink-muted">
                  {String(count).padStart(2, "0")}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- tags -->
  <div class="callout mb-8">
    <div class="flex items-center justify-between border-b border-line pb-3">
      <span class="eyebrow">Tags</span>
      <span class="sheet-meta">{String(tags.length).padStart(2, "0")}</span>
    </div>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        tags.map((tag: any) => {
          return (
            <li>
              <a
                class="tech-tag"
                href={slugSelector(`/tags/${tag}`, lang)}
              >
                {humanize(tag)}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>
