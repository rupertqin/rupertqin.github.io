---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { humanize } from "@/lib/utils/textConverter";

const {
  title = "",
  desc = "",
}: {
  title?: string;
  eyebrow?: string;
  desc?: string;
  index?: string;
} = Astro.props;
---

<div class="border-b border-line">
  <div class="wrap pb-14 pt-10 md:pb-16 md:pt-14">
    <Breadcrumbs current={title} />
    <h1 class="display mt-6">{humanize(title)}</h1>
    {desc && <p class="lede mt-5 max-w-[560px]" set:text={desc} />}
  </div>
</div>
