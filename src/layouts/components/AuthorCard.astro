---
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";
import { plainify } from "@/lib/utils/textConverter";
import ImageMod from "./ImageMod.astro";
import Social from "./Social.astro";

const { data } = Astro.props;
const { title, image, social } = data.data;
const lang = getLangFromUrl(Astro.url);
---

<div class="border border-line bg-background p-8 text-center">
  {
    image && (
      <div class="mx-auto mb-6 h-[120px] w-[120px] overflow-hidden border border-line">
        <ImageMod
          class="h-full w-full object-cover"
          src={image}
          alt={title}
          width={120}
          height={120}
          format="webp"
        />
      </div>
    )
  }
  <h4 class="mb-2 text-[18px] font-semibold text-ink">
    <a href={slugSelector(`/authors/${data.id.split("/")[1]}`, lang)}>{title}</a>
  </h4>
  <p class="mb-6 text-[14px] leading-[1.7] text-ink-sub">
    {plainify(data.body?.slice(0, 100))}
  </p>
  <Social source={social} className="social-icons" />
</div>
