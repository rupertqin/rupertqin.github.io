---
import { supportedLang } from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";

const { className, current }: { className?: string; current?: string } =
  Astro.props;

const paths = Astro.url.pathname.split("/").filter((x) => x);

let lang = "";
if (supportedLang.includes(paths[0])) {
  lang = paths.shift()!;
}

const isEn = lang === "en";

let baseHref = lang ? `/${lang}/` : "/";

let parts = [
  {
    label: isEn ? "Home" : "首页",
    href: baseHref,
    "aria-label":
      Astro.url.pathname === baseHref || Astro.url.pathname === `${baseHref}/`
        ? "page"
        : undefined,
  },
];

paths.forEach((label: string, i: number) => {
  const href = `${baseHref}${paths.slice(0, i + 1).join("/")}`;
  const isLast = i === paths.length - 1;
  label !== "page" &&
    parts.push({
      label:
        isLast && current
          ? current
          : humanize(label.replace(".html", "").replace(/[-_]/g, " ")) || "",
      href,
      "aria-label": Astro.url.pathname === href ? "page" : undefined,
    });
});
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center text-[12.5px] text-ink-muted" role="list">
    {
      parts.map(({ label, ...attrs }, index) => (
        <li class="flex items-center" role="listitem">
          {
            index > 0 && (
              <span class="mx-2 text-placeholder" aria-hidden="true">·</span>
            )
          }
          {index !== parts.length - 1 ? (
            <a class="transition-colors duration-200 hover:text-ink-strong" {...attrs}>
              {label}
            </a>
          ) : (
            <span class="text-ink-sub">{label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
