---
import config from "@/config/config.json";
const { default_theme }: { default_theme: string } = config.settings;
const { className }: { className?: string } = Astro.props;
---
{
  config.settings.theme_switcher && (
    <button
      id="theme-switcher-btn"
      class={`relative w-10 h-6 rounded-full transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 ${className || ""}`}
      aria-label="Toggle theme"
      data-theme-switcher
    >
      <span class="sr-only">Toggle theme</span>
      <!-- Track -->
      <span
        id="theme-switcher-track"
        class="absolute inset-0 rounded-full bg-gray-300 dark:bg-blue-600 transition-colors duration-300"
      ></span>
      <!-- Thumb with icons -->
      <span
        id="theme-switcher-thumb"
        class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow flex items-center justify-center transition-transform duration-300 translate-x-0 dark:translate-x-4"
      >
        <!-- Sun icon (light mode) - Feather style -->
        <svg
          id="theme-icon-sun"
          class="w-3 h-3 text-yellow-500 block dark:hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
        >
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <!-- Moon icon (dark mode) - crescent -->
        <svg
          id="theme-icon-moon"
          class="w-3 h-3 text-blue-600 hidden dark:block"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
        </svg>
      </span>
    </button>
  )
}

<script>
  import { settings } from "@/config/config.json";
  const matchMedia = window.matchMedia("(prefers-color-scheme: dark)");

  matchMedia.addEventListener("change", () => {
    applyTheme();
  });

  function applyTheme() {
    const defaulTheme =
      settings.default_theme === "system"
        ? matchMedia.matches ? "dark" : "light"
        : settings.default_theme;
    const currentTheme = localStorage.getItem("theme") || defaulTheme;
    const isDark = currentTheme === "dark";
    document.documentElement.classList.toggle("dark", isDark);

    const track = document.getElementById("theme-switcher-track");
    const thumb = document.getElementById("theme-switcher-thumb");
    if (track) {
      track.classList.toggle("bg-gray-300", !isDark);
      track.classList.toggle("bg-blue-600", isDark);
    }
    if (thumb) {
      thumb.classList.toggle("translate-x-0", !isDark);
      thumb.classList.toggle("translate-x-4", isDark);
    }
  }

  function toggleTheme() {
    const currentTheme = document.documentElement.classList.contains("dark") ? "dark" : "light";
    const newTheme = currentTheme === "light" ? "dark" : "light";
    localStorage.setItem("theme", newTheme);
    applyTheme();
  }

  // Init
  applyTheme();

  const btn = document.getElementById("theme-switcher-btn");
  if (btn) {
    btn.addEventListener("click", toggleTheme);
  }

  // Re-init after view transitions
  document.addEventListener("astro:after-swap", applyTheme);
</script>
