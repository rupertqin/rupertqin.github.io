---
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";

const lang = getLangFromUrl(Astro.url);

type Pagination = {
  section?: string;
  currentPage?: number;
  totalPages?: number;
};
const { section, currentPage = 1, totalPages = 1 }: Pagination = Astro.props;

const indexPageLink = currentPage === 2;
const hasPrevPage = currentPage > 1;
const hasNextPage = totalPages > currentPage!;

let pageList: number[] = [];
for (let i = 1; i <= totalPages; i++) {
  pageList.push(i);
}

const navItem =
  "flex h-9 min-w-9 items-center justify-center rounded-sm border border-line px-2.5 font-mono text-[12px] tabular-nums text-ink-sub transition-colors duration-200 hover:border-ink hover:text-ink";
const navActive =
  "flex h-9 min-w-9 items-center justify-center rounded-sm border border-primary bg-primary px-2.5 font-mono text-[12px] tabular-nums text-primary-foreground";
const navDisabled =
  "flex h-9 min-w-9 items-center justify-center rounded-sm border border-line/60 px-2.5 text-line-strong";
---

{
  totalPages > 1 && (
    <nav class="flex items-center justify-center gap-2" aria-label="Pagination">
      {/* previous */}
      {hasPrevPage ? (
        <a
          href={
            indexPageLink
              ? slugSelector(`/${section ? section : ""}`, lang)
              : slugSelector(
                  `/${section ? section : ""}/page/${currentPage - 1}`,
                  lang
                )
          }
          class={navItem}
        >
          <span class="sr-only">Previous</span>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" height="14" width="14">
            <path
              fill-rule="evenodd"
              d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      ) : (
        <span class={navDisabled}>
          <span class="sr-only">Previous</span>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" height="14" width="14">
            <path
              fill-rule="evenodd"
              d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
              clip-rule="evenodd"
            />
          </svg>
        </span>
      )}

      {/* page index */}
      {pageList.map((pagination, i) =>
        pagination === currentPage ? (
          <span aria-current="page" class={navActive}>
            {pagination}
          </span>
        ) : (
          <a
            href={slugSelector(
              i === 0
                ? `/${section ? section : ""}`
                : `/${section ? section : ""}/page/${pagination}`,
              lang
            )}
            class={navItem}
          >
            {pagination}
          </a>
        )
      )}

      {/* next page */}
      {hasNextPage ? (
        <a
          href={slugSelector(
            `/${section ? section : ""}/page/${currentPage + 1}`,
            lang
          )}
          class={navItem}
        >
          <span class="sr-only">Next</span>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" height="14" width="14">
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      ) : (
        <span class={navDisabled}>
          <span class="sr-only">Next</span>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" height="14" width="14">
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"
            />
          </svg>
        </span>
      )}
    </nav>
  )
}
