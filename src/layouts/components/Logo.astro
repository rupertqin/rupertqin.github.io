---
import config from "@/config/config.json";
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";

const { logo, title } = config.site;
const lang = getLangFromUrl(Astro.url);
---

<a href={slugSelector("/", lang)} class="flex items-center gap-2.5">
  <img src={logo} alt={title} class="logo-mark h-8 w-8" />
  <span class="text-[17px] font-semibold leading-none tracking-[-0.01em] text-ink">
    {config.site.logo_text || title}
  </span>
</a>
