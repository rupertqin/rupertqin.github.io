---
import CanvasScene from "@/components/canvas/CanvasScene.astro";
import type { SceneName } from "@/lib/canvas/scenes";

/**
 * Figure — a drawing plate.
 *
 * Head rail: FIG number + figure name + scale.
 * Body: either a canvas scene (`scene` prop) or the default slot.
 * Foot rail: the caption, set in the same monospace as the rest of the
 * annotations. Nothing here is interactive.
 */
interface Props {
  /** figure number without the prefix — "03" renders as FIG.03 */
  fig: string;
  title: string;
  scale?: string;
  note?: string;
  scene?: SceneName;
  /** sizing classes for the plate body, e.g. "aspect-square" */
  bodyClass?: string;
  class?: string;
}

const {
  fig,
  title,
  scale = "1:1",
  note = "",
  scene,
  bodyClass = "",
  class: className = "",
} = Astro.props;
---

<figure class={`plate ${className}`}>
  <div class="plate__head">
    <span class="flex min-w-0 items-baseline gap-2.5">
      <span class="plate__fig">FIG.{fig}</span>
      <span class="plate__title truncate">{title}</span>
    </span>
    <span class="plate__scale">Scale {scale}</span>
  </div>

  <div class={`plate__body ${bodyClass}`}>
    {
      scene ? (
        <CanvasScene scene={scene} plain class="h-full w-full" />
      ) : (
        <slot />
      )
    }
  </div>

  <figcaption class="plate__foot">
    <span class="plate__caption">{note}</span>
    <span class="plate__scale">FIG.{fig}</span>
  </figcaption>
</figure>
