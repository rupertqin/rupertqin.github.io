---
/**
 * SectionHeader — polar's section skeleton: a quiet label column, then the
 * statement. Two lines at most; the second one is grey.
 */
interface Props {
  title: string;
  index?: string;
  eyebrow?: string;
  /** second line of the headline, printed in grey */
  titleMuted?: string;
  desc?: string;
  /** `page` renders an h1 at display scale, `section` an h2. */
  size?: "page" | "section";
  class?: string;
}

const {
  title,
  index,
  eyebrow,
  titleMuted = "",
  desc = "",
  size = "section",
  class: className = "",
} = Astro.props;
---

<header class={`band-grid ${className}`}>
  <p class="kicker">
    {index && <span class="kicker__index">{index}</span>}
    {eyebrow}
  </p>

  <div>
    {
      size === "page" ? (
        <h1 class="display">
          {title}
          {titleMuted && (
            <>
              <br />
              <span class="display__muted">{titleMuted}</span>
            </>
          )}
        </h1>
      ) : (
        <h2 class="headline">
          {title}
          {titleMuted && (
            <>
              <br />
              <span class="headline__muted">{titleMuted}</span>
            </>
          )}
        </h2>
      )
    }
    {desc && <p class="lede" set:text={desc} />}
    <slot />
  </div>
</header>
