---
/**
 * SectionHeader — the site's single chapter head, now a plate head.
 *
 * Left: index + section name + figure number.
 * Middle: title (h1 on `page`, h2 on `section`).
 * Right: description, note and the scale/sheet rail.
 *
 * Every field except `title` is optional, so older call sites keep working.
 */
interface Props {
  title: string;
  index?: string;
  eyebrow?: string;
  desc?: string;
  /** figure number without the prefix, e.g. "03" renders as FIG.03 */
  fig?: string;
  /** drawing scale shown in the right rail, defaults to 1:1 */
  scale?: string;
  /** sheet number shown in the right rail */
  sheet?: string;
  /** monospace annotation under the title */
  note?: string;
  /** `page` renders an h1 at page-title scale, `section` an h2. */
  size?: "page" | "section";
  class?: string;
}

const {
  title,
  index,
  eyebrow,
  desc,
  fig = "",
  scale = "1:1",
  sheet = "",
  note = "",
  size = "section",
  class: className = "",
} = Astro.props;

const plate = Boolean(fig || sheet || note);
---

<header class={`chapter-head${plate ? " chapter-head--plate" : ""} ${className}`}>
  <div class="chapter-head__mark">
    <div class="marker">
      {index && <strong>{index}</strong>}
      {eyebrow && <span>{index ? `/ ${eyebrow}` : eyebrow}</span>}
    </div>
    {fig && <p class="chapter-head__fig">FIG.{fig}</p>}
  </div>

  {
    size === "page" ? (
      <h1 class="tech-title" set:text={title} />
    ) : (
      <h2 class="chapter-head__title" set:text={title} />
    )
  }

  {
    (desc || plate) && (
      <div class="chapter-head__side">
        {desc && <p class="chapter-head__desc" set:text={desc} />}
        {note && <p class="chapter-head__note" set:text={note} />}
        {plate && (
          <p class="chapter-head__scale">
            <span>SCALE {scale}</span>
            {sheet && <span>SHEET {sheet}</span>}
          </p>
        )}
      </div>
    )
  }
</header>
