---
/**
 * Annotation — a static leader-line note.
 *
 * Absolutely positioned inside a `relative` container (usually a `.plate`).
 * `dir="right"` starts the dot at the anchor and runs the elbow to the right of
 * it; `dir="left"` mirrors the whole thing. No hover, no animation.
 */
interface Props {
  text: string;
  /** anchored in the parent, e.g. "62%" */
  x: string;
  y: string;
  dir?: "left" | "right";
  class?: string;
}

const { text, x, y, dir = "right", class: className = "" } = Astro.props;

const path = "M1 24 H30 L64 6";
---

<div
  class={`leader ${className}`}
  style={`left:${x};top:${y};`}
  aria-hidden="true"
>
  {
    dir === "left" ? (
      <>
        <span class="leader__text pr-2 text-right">{text}</span>
        <svg
          width="64"
          height="26"
          viewBox="0 0 64 26"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          aria-hidden="true"
        >
          <path d="M63 24 H34 L0 6" vector-effect="non-scaling-stroke" />
          <circle cx="63" cy="24" r="1.7" fill="currentColor" stroke="none" />
        </svg>
      </>
    ) : (
      <>
        <svg
          width="64"
          height="26"
          viewBox="0 0 64 26"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          aria-hidden="true"
        >
          <path d={path} vector-effect="non-scaling-stroke" />
          <circle cx="1" cy="24" r="1.7" fill="currentColor" stroke="none" />
        </svg>
        <span class="leader__text pl-2">{text}</span>
      </>
    )
  }
</div>
