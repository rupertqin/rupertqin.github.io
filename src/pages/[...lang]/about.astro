---
import CanvasScene from "@/components/canvas/CanvasScene.astro";
import ImageMod from "@/components/ImageMod.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { render } from "astro:content";
import { supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const about = await getListPage("about", lang);
if (about[0].data.draft) {
  return Astro.redirect("/404");
}

const { Content } = await render(about[0]);
const { title, description, meta_title, image } = about[0].data;
---

<Base title={title} meta_title={meta_title} description={description} image={image}>
  <section class="band--first pb-20 md:pb-28">
    <div class="wrap">
      <SectionHeader
        index="01"
        eyebrow={lang === "en" ? "About" : "关于我们"}
        title={title}
        desc={description}
      />

      <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <div class="content">
            <Content />
          </div>
        </div>

        <div class="lg:col-span-5">
          {
            image && (
              <ImageMod
                class="aspect-[4/3] w-full rounded-[14px] object-cover"
                src={image}
                width={1200}
                height={600}
                alt={title}
                format="webp"
                fit="cover"
              />
            )
          }
          <div class="media media--field mt-8 aspect-square">
            <CanvasScene scene="venn" plain class="media__art absolute inset-0 h-full w-full" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
