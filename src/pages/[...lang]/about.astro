---
import CanvasScene from "@/components/canvas/CanvasScene.astro";
import ImageMod from "@/components/ImageMod.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { render } from "astro:content";
import { supportedLang } from "@/lib/utils/languageParser";


export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const about = await getListPage("about", lang);
if (about[0].data.draft) {
  return Astro.redirect("/404");
}

const { Content } = await render(about[0]);
const { title, description, meta_title, image } = about[0].data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section class="section-sm">
    <div class="container relative">
      <CanvasScene
        scene="venn"
        plain
        class="pointer-events-none absolute right-5 top-0 hidden aspect-square w-[260px] lg:block"
      />
      <div class="row justify-center">
        <div class="md:col-10 lg:col-8">
          <SectionHeader
            index="06"
            eyebrow="About / 关于我们"
            title={title}
            desc={description}
            fig="06"
            sheet="07"
            note="Portrait / 1:1"
            class="mb-8"
          />
          {
            image && (
              <figure class="plate mb-9">
                <div class="plate__head">
                  <span class="flex min-w-0 items-baseline gap-2.5">
                    <span class="plate__fig">FIG.06</span>
                    <span class="plate__title">Portrait</span>
                  </span>
                  <span class="plate__scale">Scale 1:1</span>
                </div>
                <div class="plate__body aspect-[2/1]">
                  <ImageMod
                    class="h-full w-full object-cover"
                    src={image}
                    width={1200}
                    height={600}
                    alt={title}
                    format="webp"
                    fit="cover"
                  />
                </div>
                <figcaption class="plate__foot">
                  <span class="plate__caption">{title}</span>
                  <span class="plate__scale">FIG.06</span>
                </figcaption>
              </figure>
            )
          }
          <div class="content">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
