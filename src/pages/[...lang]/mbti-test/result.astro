---
import Base from "@/layouts/Base.astro";
import { getLangFromUrl } from "@/lib/utils/languageParser";
import { supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang === "zh" ? undefined : lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
---

<Base title={lang === "en" ? "MBTI Test Result" : "MBTI 测试结果"} lang={lang}>
  <section class="section">
    <div class="container max-w-4xl mx-auto">
      <div id="result-container" class="space-y-12">
        <!-- 类型结果 -->
        <div class="text-center">
          <h1 id="type-result" class="text-5xl font-bold text-purple-600 dark:text-purple-400"></h1>
          <p id="type-description" class="text-xl text-gray-600 dark:text-gray-300 mt-4"></p>
        </div>

        <!-- 认知功能 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow">
            <h3 class="text-lg font-semibold mb-2 text-green-600">主导功能 (Dominant)</h3>
            <p id="dominant-function" class="text-gray-700 dark:text-gray-300"></p>
          </div>
          <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow">
            <h3 class="text-lg font-semibold mb-2 text-blue-600">辅助功能 (Auxiliary)</h3>
            <p id="auxiliary-function" class="text-gray-700 dark:text-gray-300"></p>
          </div>
          <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow">
            <h3 class="text-lg font-semibold mb-2 text-yellow-600">第三功能 (Tertiary)</h3>
            <p id="tertiary-function" class="text-gray-700 dark:text-gray-300"></p>
          </div>
          <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow">
            <h3 class="text-lg font-semibold mb-2 text-red-600">劣势功能 (Inferior)</h3>
            <p id="inferior-function" class="text-gray-700 dark:text-gray-300"></p>
          </div>
        </div>

        <!-- 优势 -->
        <div>
          <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white">优势</h2>
          <ul id="strengths-list" class="grid grid-cols-1 md:grid-cols-2 gap-3"></ul>
        </div>

        <!-- 发展领域 -->
        <div>
          <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white">发展领域</h2>
          <ul id="weaknesses-list" class="grid grid-cols-1 md:grid-cols-2 gap-3"></ul>
        </div>

        <!-- 职业建议 -->
        <div>
          <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white">职业建议</h2>
          <div id="career-suggestions" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
        </div>

        <!-- 发展建议 -->
        <div>
          <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white">发展建议</h2>
          <div id="development-areas" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
        </div>

        <!-- 人际关系 -->
        <div>
          <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white">人际关系</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-lg font-semibold mb-4 text-rose-600">优势</h3>
              <ul id="relationship-strengths" class="space-y-2"></ul>
            </div>
            <div>
              <h3 class="text-lg font-semibold mb-4 text-orange-600">挑战</h3>
              <ul id="relationship-challenges" class="space-y-2"></ul>
            </div>
          </div>
        </div>

        <!-- 工作风格 -->
        <div>
          <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-white">工作风格</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-lg font-semibold mb-4 text-emerald-600">优势</h3>
              <ul id="work-strengths" class="space-y-2"></ul>
            </div>
            <div>
              <h3 class="text-lg font-semibold mb-4 text-red-600">挑战</h3>
              <ul id="work-challenges" class="space-y-2"></ul>
            </div>
          </div>
        </div>

        <!-- 重新测试 -->
        <div class="text-center pt-8">
          <a
            href={`/${lang}/mbti-test`}
            class="inline-block px-8 py-3 text-lg font-medium bg-gradient-to-r from-purple-600 to-blue-500 text-white rounded-xl hover:opacity-90 transition-opacity"
          >
            {lang === "en" ? "Retake Test" : "重新测试"}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { analyzeType } from "@/lib/mbti-analysis";

  const validMBTITypes = [
    "ISTJ","ISFJ","INFJ","INTJ","ISTP","ISFP","INFP","INTP",
    "ESTP","ESFP","ENFP","ENTP","ESTJ","ESFJ","ENFJ","ENTJ"
  ];

  function getMBTITypeFromURL(): string | null {
    const params = new URLSearchParams(window.location.search);
    const type = params.get("type");
    if (!type || !validMBTITypes.includes(type.toUpperCase())) return null;
    return type.toUpperCase();
  }

  function checkValidSource() {
    const type = getMBTITypeFromURL();
    if (!type) window.location.href = `/${document.documentElement.lang === "en" ? "en" : "zh"}/mbti-test`;
  }

  function showResult(type: string) {
    const analysis = analyzeType(type);
    if (!analysis) { console.error("Cannot analyze type:", type); return; }

    const lang = document.documentElement.lang === "en" ? "en" : "zh";

    document.getElementById("type-result")!.textContent = analysis.type;
    document.getElementById("type-description")!.textContent = analysis.description;

    const strengthsList = document.getElementById("strengths-list")!;
    strengthsList.innerHTML = "";
    analysis.strengths.forEach((s: string) => {
      const li = document.createElement("li");
      li.className = "flex items-center space-x-2";
      li.innerHTML = `<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg><span>${s}</span>`;
      strengthsList.appendChild(li);
    });

    const weaknessesList = document.getElementById("weaknesses-list")!;
    weaknessesList.innerHTML = "";
    analysis.weaknesses.forEach((w: string) => {
      const li = document.createElement("li");
      li.className = "flex items-center space-x-2";
      li.innerHTML = `<svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg><span>${w}</span>`;
      weaknessesList.appendChild(li);
    });

    (document.getElementById("dominant-function") as HTMLElement).textContent = analysis.cognitiveFunctions.dominant;
    (document.getElementById("auxiliary-function") as HTMLElement).textContent = analysis.cognitiveFunctions.auxiliary;
    (document.getElementById("tertiary-function") as HTMLElement).textContent = analysis.cognitiveFunctions.tertiary;
    (document.getElementById("inferior-function") as HTMLElement).textContent = analysis.cognitiveFunctions.inferior;

    const careerList = document.getElementById("career-suggestions")!;
    careerList.innerHTML = "";
    analysis.careerSuggestions.forEach((c: string) => {
      const div = document.createElement("div");
      div.className = "flex items-center space-x-2 bg-white dark:bg-gray-700 p-4 rounded-lg shadow";
      div.innerHTML = `<svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg><span class="text-gray-700 dark:text-gray-300">${c}</span>`;
      careerList.appendChild(div);
    });

    const developmentList = document.getElementById("development-areas")!;
    developmentList.innerHTML = "";
    analysis.developmentAreas.forEach((a: string) => {
      const div = document.createElement("div");
      div.className = "flex items-center space-x-2 bg-white dark:bg-gray-700 p-4 rounded-lg shadow";
      div.innerHTML = `<svg class="w-5 h-5 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg><span class="text-gray-700 dark:text-gray-300">${a}</span>`;
      developmentList.appendChild(div);
    });

    const relStrList = document.getElementById("relationship-strengths")!;
    relStrList.innerHTML = "";
    analysis.relationshipStrengths.forEach((s: string) => {
      const li = document.createElement("li");
      li.className = "flex items-center space-x-2";
      li.innerHTML = `<svg class="w-5 h-5 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg><span>${s}</span>`;
      relStrList.appendChild(li);
    });

    const relChalList = document.getElementById("relationship-challenges")!;
    relChalList.innerHTML = "";
    analysis.relationshipChallenges.forEach((c: string) => {
      const li = document.createElement("li");
      li.className = "flex items-center space-x-2";
      li.innerHTML = `<svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg><span>${c}</span>`;
      relChalList.appendChild(li);
    });

    const workStrList = document.getElementById("work-strengths")!;
    workStrList.innerHTML = "";
    analysis.workStyleStrengths.forEach((s: string) => {
      const li = document.createElement("li");
      li.className = "flex items-center space-x-2";
      li.innerHTML = `<svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg><span>${s}</span>`;
      workStrList.appendChild(li);
    });

    const workChalList = document.getElementById("work-challenges")!;
    workChalList.innerHTML = "";
    analysis.workStyleChallenges.forEach((c: string) => {
      const li = document.createElement("li");
      li.className = "flex items-center space-x-2";
      li.innerHTML = `<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg><span>${c}</span>`;
      workChalList.appendChild(li);
    });
  }

  document.addEventListener("astro:page-load", () => {
    // Guard against duplicate execution
    if ((window as any)._mbtiResultLoaded) return;
    (window as any)._mbtiResultLoaded = true;

    checkValidSource();
    const type = getMBTITypeFromURL();
    if (type) showResult(type);
    else window.location.href = `/${document.documentElement.lang === "en" ? "en" : "zh"}/mbti-test`;
  });
</script>
