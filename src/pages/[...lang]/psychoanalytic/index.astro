---
import CanvasScene from "@/components/canvas/CanvasScene.astro";
import Base from "@/layouts/Base.astro";
import { getGraphic } from "@/lib/canvas/catalog";
import { getLangFromUrl } from "@/lib/utils/languageParser";
import { supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang === "zh" ? undefined : lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const isEn = lang === "en";
const mbtiTestUrl = isEn ? "/en/psychoanalytic/mbti-test" : "/psychoanalytic/mbti-test";
const cogFuncUrl = isEn ? "/en/psychoanalytic/cognitive-functions-table" : "/psychoanalytic/cognitive-functions-table";

const t = {
  pageTitle: isEn ? "Psychoanalytic - MBTI Test and Cognitive Functions" : "心理分析 - MBTI 测试与认知功能",
  heroTitle: isEn ? "MBTI Test \u2014 Discover Your True Self" : "MBTI测试发现真实的自己",
  heroDesc: isEn ? "Get a surprisingly accurate personality description in just 10 minutes. Understand your behavior and why." : "仅需10分钟，获得惊人准确的性格描述，了解你的行为方式和原因。",
  startTest: isEn ? "Start Test \u2192" : "开始测试 \u2192",
  dailyTests: isEn ? "DAILY TESTS" : "今日测试人数",
  totalTests: isEn ? "Total Tests" : "总测试人数",
  accuracy: isEn ? "Accuracy" : "准确率",
  userQuote1: isEn ? '"The MBTI test is incredibly accurate! It helped me not only understand myself but also communicate better with my colleagues."' : '"MBTI测试非常准确！它帮助我不仅了解自己，还能更好地与同事沟通。"',
  userQuote2: isEn ? '"I was skeptical at first, but the insights were spot-on. The MBTI test helped me make better career decisions and improve my relationships."' : '"起初我很怀疑，但洞察非常准确。MBTI测试帮助我做出更好的职业决策，改善我的人际关系。"',
  userQuote3: isEn ? '"The MBTI test gave me the clarity I needed. Understanding my personality type has been transformative for both my personal and professional life."' : '"MBTI测试给了我所需的清晰度。了解我的性格类型对我的个人和职业生活都产生了变革性的影响。"',
  faqWhat: isEn ? "What is the MBTI test?" : "什么是MBTI测试？",
  faqWhatAns: isEn ? "The MBTI test is a personality assessment tool based on the Myers-Briggs Type Indicator (MBTI). Our platform provides detailed personality insights to help you better understand yourself and improve your relationships with others." : "MBTI测试是一个基于迈尔斯-布里格斯类型指标（MBTI）的性格评估工具。我们的平台提供详细的性格特征洞察，帮助你更好地理解自己和改善与他人的关系。",
  faqAcc: isEn ? "How accurate is the MBTI test?" : "MBTI测试的准确度如何？",
  faqAccAns: isEn ? 'The MBTI test has been refined through extensive research and user feedback. Over 91% of users report their results as "accurate" or "very accurate." However, remember that personality is complex and may change over time.' : 'MBTI测试经过广泛研究和用户反馈的完善。超过91%的用户认为他们的结果"准确"或"非常准确"。然而，请记住性格是复杂的，可能会随时间变化。我们建议定期重新测试以追踪性格类型的变化。',
  faqTime: isEn ? "How long does the MBTI test take?" : "MBTI测试需要多长时间？",
  faqTimeAns: isEn ? "The MBTI test typically takes 10-15 minutes to complete. Our questions are designed to be straightforward yet comprehensive, ensuring you get accurate results without taking too much of your time." : "MBTI测试通常需要10-15分钟完成。我们设计的问题简单明了但全面，确保你能获得准确的结果而不会花费太多时间。",
  faqResult: isEn ? "What will I get after completing the MBTI test?" : "完成MBTI测试后我会得到什么？",
  faqResultAns: isEn ? "After completing the test, you will receive:" : "完成测试后，你将收到：",
  faqResult1: isEn ? "Your detailed personality type profile" : "你的详细性格类型档案",
  faqResult2: isEn ? "Insights into your strengths and potential growth areas" : "关于你的优势和潜在成长领域的洞察",
  faqResult3: isEn ? "Tips for better communication with other personality types" : "与其他性格类型更好沟通的技巧",
  faqResult4: isEn ? "Career suggestions matching your personality type" : "与你的性格类型匹配的职业建议",
  faqResult5: isEn ? "Relationship compatibility insights" : "关系兼容性洞察",
  faqTeam: isEn ? "Can the MBTI test help with team building?" : "MBTI测试能帮助团队建设吗？",
  faqTeamAns: isEn ? "Yes! The MBTI test offers dedicated team assessments that can help improve team dynamics, communication, and collaboration. Understanding team members' personality types can lead to better working relationships, increased productivity, and more effective conflict resolution." : "是的！MBTI测试提供专门的团队评估，可以帮助改善团队动态、沟通和协作。了解团队成员的性格类型可以带来更好的工作关系、提高生产力和更有效的冲突解决。",
  faqSafe: isEn ? "Is my data safe with the MBTI test?" : "我的数据在MBTI测试中安全吗？",
  faqSafeAns: isEn ? "Absolutely. At the MBTI test, we take your privacy very seriously. All test responses and personal information are encrypted and securely stored. We never share your personal data with third parties." : "绝对安全。在MBTI测试中，我们非常重视你的隐私。所有测试回答和个人信息都经过加密并安全存储。我们绝不会与第三方共享你的个人数据。你可以在我们的隐私政策中了解更多。",
  sectionPersonalityType: isEn ? "PERSONALITY TYPES" : "性格类型",
  exploreTitle: isEn ? "Explore 16 Personality Types" : "探索16种性格类型与MBTI测试",
  exploreDesc: isEn ? "In our free type descriptions, you'll discover what truly drives, inspires, and worries different personality types, helping you build more meaningful relationships." : "在我们免费的类型描述中，你将了解不同性格类型的真正驱动力、灵感和担忧，帮助你建立更有意义的关系。",
  cognitiveFuncLink: isEn ? "Cognitive Functions Analysis" : "认知功能与八维分析",
  sectionTeams: isEn ? "TEAMS" : "团队",
  teamsTitle: isEn ? "MBTI Test for Teams" : "MBTI测试团队版",
  teamsDesc: isEn ? "Better understand your team through our team assessment. Improve communication, create harmony, and help team members develop personal strengths." : "通过我们的团队评估更好地了解你的团队。改善沟通，创造和谐，帮助团队成员发展个人优势。适用于各种规模的团队。",
  startNow: isEn ? "Start Test Now" : "立即开始测试",
  howTitle: isEn ? "How MBTI Test Works" : "MBTI测试如何工作",
  step1Title: isEn ? "Prepare Yourself" : "准备自己",
  step1Desc: isEn ? "Make sure you are in a relaxing environment conducive to focus." : "确保你在一个有利于集中注意力的放松环境中进行测试。",
  step2Title: isEn ? "Complete the Test" : "完成测试",
  step2Desc: isEn ? "Answer questions designed to reveal aspects of your personality." : "回答设计用来揭示你性格各个方面的问题。",
  step3Title: isEn ? "Get Insights" : "获取洞察",
  step3Desc: isEn ? "View your report, explore personality types, and find where you belong!" : "查看你的报告，探索各种性格类型，找出你的归属！",
  storyTitle: isEn ? "MBTI Test Success Stories" : "MBTI测试成功故事",
  storyDesc: isEn ? "Here are what some users say about their personality test experience." : "以下是一些用户对我们性格测试体验的评价。",
  ctaTitle: isEn ? "Start Your MBTI Journey Today" : "今天就开始你的MBTI测试之旅",
  ctaDesc: isEn ? "Join millions who have found clarity and self-understanding through our personality test." : "加入数百万通过我们的性格测试找到清晰和自我理解的人",
  userPotential: isEn ? "They unlocked their potential through testing." : "他们通过测试释放了潜能。",
};

const stats = [
  { value: "32K+", label: t.dailyTests },
  { value: "13M+", label: t.totalTests },
  { value: "91.2%", label: t.accuracy },
];

const steps = [
  { title: t.step1Title, desc: t.step1Desc },
  { title: t.step2Title, desc: t.step2Desc },
  { title: t.step3Title, desc: t.step3Desc },
];

const stories = [
  { quote: t.userQuote1, name: "Johnson", type: "ENFJ", avatar: "/images/user1.jpg" },
  { quote: t.userQuote2, name: "Michael Smith", type: "INFJ", avatar: "/images/user2.jpg" },
  { quote: t.userQuote3, name: "Emma", type: "ISTJ", avatar: "/images/user3.jpg" },
];

const faqs = [
  { q: t.faqWhat, a: t.faqWhatAns },
  { q: t.faqAcc, a: t.faqAccAns },
  { q: t.faqTime, a: t.faqTimeAns },
  { q: t.faqResult, a: t.faqResultAns, list: [t.faqResult1, t.faqResult2, t.faqResult3, t.faqResult4, t.faqResult5] },
  { q: t.faqTeam, a: t.faqTeamAns },
  { q: t.faqSafe, a: t.faqSafeAns },
];

const graphics = [
  getGraphic("textRings"),
  getGraphic("vector"),
  getGraphic("venn"),
  getGraphic("linkedRings"),
];
---

<Base title={t.pageTitle} lang={lang}>
  <!-- Hero -->
  <section class="border-b border-line">
    <div class="container py-16 md:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">{isEn ? "Psychoanalytic / MBTI" : "心理分析 / MBTI"}</p>
          <h1 class="mt-6 text-[clamp(32px,4.6vw,52px)] font-semibold leading-[1.1] tracking-[-0.035em] text-ink">
            {t.heroTitle}
          </h1>
          <p class="mt-6 max-w-[560px] text-[17px] leading-[1.75] text-ink-sub">
            {t.heroDesc}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={mbtiTestUrl} class="btn btn-primary btn-lg">{t.startTest}</a>
            <a href={cogFuncUrl} class="tech-link text-[14px]">{t.cognitiveFuncLink}</a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="callout">
            <p class="eyebrow border-b border-line pb-4">{isEn ? "Stats / Live" : "实时数据"}</p>
            <div class="mt-5 space-y-5">
              {stats.map((stat) => (
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">{stat.label}</span>
                  <span class="tech-num text-[24px] font-semibold leading-none text-ink">{stat.value}</span>
                </div>
              ))}
            </div>
            <div class="mt-6 border-t border-line pt-5">
              <img src="/images/test-users.png" alt="User" class="h-auto w-[161px]" />
              <p class="mt-3 text-[12px] leading-[1.6] text-ink-muted">{t.userPotential}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Figures -->
  <section class="border-b border-line">
    <div class="container py-14 md:py-16">
      <p class="eyebrow">{isEn ? "Figures / Set" : "图形 / 组"}</p>
      <div class="mt-8 grid grid-cols-2 gap-5 md:grid-cols-4 md:gap-6">
        {graphics.map((tile) => (
          <figure>
            <CanvasScene scene={tile.key} class="aspect-square w-full" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Personality types -->
  <section class="border-b border-line">
    <div class="container py-16 md:py-20">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">{t.sectionPersonalityType}</p>
          <h2 class="mt-4 text-[clamp(24px,3vw,32px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
            {t.exploreTitle}
          </h2>
          <p class="mt-5 max-w-[560px] text-[16px] leading-[1.75] text-ink-sub">{t.exploreDesc}</p>
          <a href={cogFuncUrl} class="tech-link mt-7 text-[14px] font-medium">
            {t.cognitiveFuncLink}
            <svg class="h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 8h11M9.5 4l4 4-4 4" />
            </svg>
          </a>
        </div>
        <div class="lg:col-span-5">
          <div class="media-frame flex items-center justify-center p-6">
            <img src="/images/personality-types.jpg" alt="Personality Types Illustration" class="w-[280px]" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Teams -->
  <section class="border-b border-line">
    <div class="container py-16 md:py-20">
      <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
        <div>
          <p class="eyebrow">{t.sectionTeams}</p>
          <h2 class="mt-4 text-[clamp(24px,3vw,32px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
            {t.teamsTitle}
          </h2>
          <p class="mt-5 max-w-[520px] text-[16px] leading-[1.75] text-ink-sub">{t.teamsDesc}</p>
          <a href={mbtiTestUrl} class="btn btn-primary mt-8">{t.startNow}</a>
        </div>
        <div class="media-frame flex items-center justify-center p-6">
          <img src="/images/team-assessments.jpg" alt="Team Assessments Illustration" class="w-full max-w-[520px]" />
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-b border-line">
    <div class="container py-16 md:py-20">
      <div class="tech-section-head">
        <p class="eyebrow">{isEn ? "Process" : "流程"}</p>
        <h2 class="mt-4 text-[clamp(24px,3vw,32px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
          {t.howTitle}
        </h2>
      </div>
      <div class="tech-grid">
        {steps.map((step, i) => (
          <div class="tech-feature">
            <span class="tech-feature-index">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="tech-feature-title">{step.title}</h3>
            <p class="mt-3 text-[15px] leading-[1.7] text-ink-sub">{step.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-12">
        <a href={mbtiTestUrl} class="btn btn-outline-primary">{t.startNow}</a>
      </div>
    </div>
  </section>

  <!-- Success stories -->
  <section class="border-b border-line">
    <div class="container py-16 md:py-20">
      <div class="tech-section-head">
        <p class="eyebrow">{isEn ? "References" : "用户反馈"}</p>
        <h2 class="mt-4 text-[clamp(24px,3vw,32px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
          {t.storyTitle}
        </h2>
        <p class="mt-3 max-w-[560px] text-[15px] leading-[1.7] text-ink-muted">{t.storyDesc}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {stories.map((story) => (
          <figure class="tech-quote">
            <blockquote class="text-[15px] leading-[1.75] text-ink-sub">{story.quote}</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <img src={story.avatar} alt={story.name} class="h-10 w-10 rounded-full border border-line" />
              <div>
                <p class="text-[14px] font-medium text-ink">{story.name}</p>
                <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">{story.type}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="container py-16 md:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="eyebrow">{isEn ? "FAQ" : "常见问题"}</p>
          <h2 class="mt-4 text-[clamp(24px,3vw,32px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
            {isEn ? "Frequently Asked Questions" : "关于MBTI测试的常见问题"}
          </h2>
        </div>
        <div class="lg:col-span-8">
          <div class="border-t border-line">
            {faqs.map((faq) => (
              <details class="group border-b border-line py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-ink">
                  {faq.q}
                  <span class="font-mono text-[13px] text-ink-muted transition-transform duration-200 group-open:rotate-45">+</span>
                </summary>
                <div class="mt-3 max-w-[680px] text-[14px] leading-[1.75] text-ink-sub">
                  <p>{faq.a}</p>
                  {faq.list && (
                    <ul class="mt-2 list-disc space-y-1 pl-5">
                      {faq.list.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="tech-band">
    <div class="container py-16 md:py-20">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">{isEn ? "Get Started" : "开始测试"}</p>
          <h2 class="mt-4 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
            {t.ctaTitle}
          </h2>
          <p class="mt-4 max-w-[520px] text-[16px] leading-[1.75] text-ink-sub">{t.ctaDesc}</p>
        </div>
        <a href={mbtiTestUrl} class="btn btn-primary btn-lg shrink-0">{t.startNow}</a>
      </div>
    </div>
  </section>
</Base>
