---
import Base from "@/layouts/Base.astro";
import { getLangFromUrl } from "@/lib/utils/languageParser";
import { supportedLang } from "@/lib/utils/languageParser";
import { mbtiQuestions } from "@/data/mbti-questions";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang === "zh" ? undefined : lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const isEn = lang === "en";
const mbtiQuestionsJson = JSON.stringify(mbtiQuestions);
---

<Base title={isEn ? "MBTI Test - Psychoanalytic" : "MBTI 测试 - 心理分析"} lang={lang}>
  <div class="container py-14 md:py-20">
    <div class="mx-auto max-w-4xl">
      <div class="flex items-center justify-between gap-6">
        <p class="eyebrow">{isEn ? "Psychoanalytic / MBTI" : "心理分析 / MBTI"}</p>
        <span class="sheet-meta hidden sm:inline-flex">
          <span>Form 01</span>
          <i class="sheet-meta__dot"></i>
          <span>Scale 1:1</span>
        </span>
      </div>
      <h1 class="mt-4 text-[clamp(28px,4vw,40px)] font-semibold leading-[1.15] tracking-[-0.025em] text-ink">
        {isEn ? "MBTI Test" : "MBTI 测试"}
      </h1>
      <div class="dim mt-6">
        <span class="dim__value">60 items</span>
      </div>
      <div class="rule-pair mt-6" aria-hidden="true"></div>

      <!-- Intro -->
      <div id="intro-container" class="plate mt-8">
        <div class="plate__head">
          <span class="flex min-w-0 items-baseline gap-2.5">
            <span class="plate__fig">FORM.01</span>
            <span class="plate__title">{isEn ? "Brief" : "测试说明"}</span>
          </span>
          <span class="plate__scale">60 Q / 20 min</span>
        </div>
        <div class="px-6 py-6 md:px-8 md:py-8">
          <p class="max-w-[640px] text-[15px] leading-[1.75] text-ink-sub">
            {isEn
              ? "This test consists of 60 questions. Please choose the option that best matches your true thoughts. The test takes about 10-20 minutes."
              : "本测试包含60个问题，请根据你的真实想法选择最符合你的选项。测试大约需要10-20分钟完成。"}
          </p>

          <div class="mt-6 border border-line p-5">
            <h3 class="font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-ink">
              {isEn ? "Test Tips" : "测试提示"}
            </h3>
            <ul class="mt-3 space-y-2 text-[14px] leading-[1.7] text-ink-sub">
              <li class="flex gap-2.5">
                <span class="font-mono text-[11px] text-ink-muted">01</span>
                <span>{isEn ? "Choose the option that best matches your true thoughts" : "选择最符合你真实想法的选项"}</span>
              </li>
              <li class="flex gap-2.5">
                <span class="font-mono text-[11px] text-ink-muted">02</span>
                <span>{isEn ? "Don't overthink, trust your first instinct" : "不要过度思考，相信你的第一直觉"}</span>
              </li>
              <li class="flex gap-2.5">
                <span class="font-mono text-[11px] text-ink-muted">03</span>
                <span>{isEn ? "Choose the option you prefer, not the one you think is 'correct'" : "选择你更倾向于的选项，而不是你认为正确的选项"}</span>
              </li>
              <li class="flex gap-2.5">
                <span class="font-mono text-[11px] text-ink-muted">04</span>
                <span>{isEn ? "If neither option fits perfectly, choose the closer one" : "如果两个选项都不完全符合，选择更接近你真实想法的那个"}</span>
              </li>
            </ul>
          </div>

          <div class="mt-8">
            <button id="start-test-btn" class="btn btn-primary btn-lg">
              {isEn ? "Start Test" : "开始测试"}
            </button>
          </div>
        </div>
      </div>

      <!-- Test Questions -->
      <div id="test-container" class="plate mt-8 hidden">
        <div class="plate__head">
          <span class="flex min-w-0 items-baseline gap-2.5">
            <span class="plate__fig">FORM.02</span>
            <span class="plate__title">{isEn ? "Answer sheet" : "答题纸"}</span>
          </span>
          <span class="plate__scale">01 / 60</span>
        </div>
        <div class="mx-auto max-w-3xl px-6 py-6 md:px-8 md:py-8">
          <h2 class="text-[20px] font-semibold tracking-[-0.02em] text-ink">
            {isEn ? "MBTI Personality Test" : "MBTI 人格测试"}
          </h2>
          <p class="mt-2 text-[14px] text-ink-sub">
            {isEn ? "60 questions total, choose the option that best matches your situation" : "共 60 题，请根据您的实际情况选择最符合的选项"}
          </p>
        </div>

        <div id="test-questions" class="mt-8 space-y-8">
            <div class="space-y-3">
              <div class="flex items-baseline justify-between">
                <span id="progress-text" class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-muted">
                  {isEn ? "Question 1 of 60" : "第 1 题，共 60 题"}
                </span>
                <span class="font-mono text-[11px] text-ink-muted">01 / 60</span>
              </div>
              <div class="h-1.5 w-full border border-line">
                <div id="progress-bar" class="h-full bg-ink-strong transition-all duration-300" style="width: 0%"></div>
              </div>
            </div>

            <div id="question-cards-container"></div>

            <div class="mt-10 flex justify-between border-t border-line pt-6">
              <button id="prev-btn" class="btn btn-outline-primary disabled:cursor-not-allowed disabled:opacity-40">
                {isEn ? "Previous" : "上一题"}
              </button>
              <button id="next-btn" class="btn btn-primary">
                {isEn ? "Next" : "下一题"}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
</Base>

<script is:inline define:vars={{ __mbtiData: mbtiQuestionsJson }}>
  window.__MBTI_QUESTIONS__ = JSON.parse(__mbtiData);
</script>

<script>
  function initMbtiTest() {
    const introContainer = document.getElementById("intro-container");
    const testContainer = document.getElementById("test-container");
    const startBtn = document.getElementById("start-test-btn");
    const questionCardsContainer = document.getElementById("question-cards-container");
    const progressBar = document.getElementById("progress-bar");
    const progressText = document.getElementById("progress-text");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");

    if (!startBtn || !introContainer || !testContainer || !questionCardsContainer) return;

    const mbtiQuestions = window.__MBTI_QUESTIONS__;
    if (!mbtiQuestions) return;

    let currentQuestion = 0;
    const answers = {};
    const totalQuestions = mbtiQuestions.length;

    startBtn.addEventListener("click", function () {
      introContainer.classList.add("hidden");
      testContainer.classList.remove("hidden");
      renderQuestions();
      showQuestion(0);
    });

    function renderQuestions() {
      questionCardsContainer.innerHTML = "";
      const lang = document.documentElement.lang === "en" ? "en" : "zh";

      mbtiQuestions.forEach(function (question, index) {
        const card = document.createElement("div");
        card.className = "question-card hidden";
        card.setAttribute("data-question-id", String(question.id));
        card.setAttribute("data-dimension", question.dimension);
        card.setAttribute("data-direction", question.direction);

        const questionText = lang === "en" ? question.question.en : question.question.zh;

        card.innerHTML = `
          <h3 class="mx-auto mb-10 max-w-2xl text-center text-[20px] font-semibold leading-snug tracking-[-0.02em] text-ink">${questionText}</h3>
          <div class="mx-auto flex w-full max-w-2xl flex-col gap-6">
            <div class="mb-2 flex items-center justify-between px-4 font-mono text-[10px] uppercase tracking-[0.12em]">
              <span class="text-ink">${lang === "en" ? "Agree" : "同意"}</span>
              <span class="text-ink-muted">${lang === "en" ? "Disagree" : "不同意"}</span>
            </div>
            <div class="flex justify-between items-center gap-2 sm:gap-4 px-2 relative">
              <button type="button" class="option-btn size-10 sm:size-14" data-value="left3">
                <svg class="w-4 sm:w-6 h-4 sm:h-6 check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </button>
              <button type="button" class="option-btn size-9 sm:size-12" data-value="left2">
                <svg class="w-4 sm:w-5 h-4 sm:h-5 check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </button>
              <button type="button" class="option-btn size-8 sm:size-10" data-value="left1">
                <svg class="w-3 sm:w-4 h-3 sm:h-4 check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </button>
              <button type="button" class="option-btn size-7 sm:size-8" data-value="middle">
                <svg class="w-3 sm:w-4 h-3 sm:h-4 check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </button>
              <button type="button" class="option-btn size-8 sm:size-10" data-value="right1">
                <svg class="w-3 sm:w-4 h-3 sm:h-4 check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </button>
              <button type="button" class="option-btn size-9 sm:size-12" data-value="right2">
                <svg class="w-4 sm:w-5 h-4 sm:h-5 check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </button>
              <button type="button" class="option-btn size-10 sm:size-14" data-value="right3">
                <svg class="w-4 sm:w-6 h-4 sm:h-6 check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </button>
            </div>
          </div>
        `;

        questionCardsContainer.appendChild(card);
      });

      document.querySelectorAll(".question-card").forEach(function (card) {
        var questionId = parseInt(card.getAttribute("data-question-id") || "0") - 1;
        var options = card.querySelectorAll(".option-btn");
        options.forEach(function (option) {
          option.addEventListener("click", function (e) {
            var target = e.currentTarget;
            options.forEach(function (opt) { opt.classList.remove("selected"); });
            target.classList.add("selected");
            var value = target.getAttribute("data-value") || "middle";
            saveAnswer(questionId, value);
          });
        });
      });
    }

    function showQuestion(index) {
      var questionCards = document.querySelectorAll(".question-card");
      questionCards.forEach(function (card, i) {
        card.classList.toggle("hidden", i !== index);
      });

      var lang = document.documentElement.lang === "en" ? "en" : "zh";
      var progressLabel = lang === "en" ? "Question " + (index + 1) + " of " + totalQuestions : "第 " + (index + 1) + " 题，共 " + totalQuestions + " 题";
      var nextLabel = index === totalQuestions - 1 ? (lang === "en" ? "View Result" : "查看结果") : (lang === "en" ? "Next" : "下一题");
      var prevLabel = lang === "en" ? "Previous" : "上一题";

      progressBar.style.width = ((index + 1) / totalQuestions * 100) + "%";
      progressText.textContent = progressLabel;
      prevBtn.disabled = index === 0;
      nextBtn.textContent = nextLabel;
      prevBtn.textContent = prevLabel;
    }

    function calculatePersonalityType() {
      var totals = { E: 0, I: 0, S: 0, N: 0, T: 0, F: 0, J: 0, P: 0 };
      Object.values(answers).forEach(function (answer) {
        totals[answer.dimension] += answer.score;
      });
      var result = "";
      result += totals.E > totals.I ? "E" : "I";
      result += totals.S > totals.N ? "S" : "N";
      result += totals.T > totals.F ? "T" : "F";
      result += totals.J > totals.P ? "J" : "P";
      return result;
    }

    function saveAnswer(questionId, value) {
      var questionCard = document.querySelector('[data-question-id="' + (questionId + 1) + '"]');
      if (!questionCard) return;
      var dimensionPair = questionCard.getAttribute("data-dimension");
      var direction = questionCard.getAttribute("data-direction");

      var rawScore = 0;
      switch (value) {
        case "left3": rawScore = 3; break;
        case "left2": rawScore = 2; break;
        case "left1": rawScore = 1; break;
        case "middle": rawScore = 0; break;
        case "right1": rawScore = -1; break;
        case "right2": rawScore = -2; break;
        case "right3": rawScore = -3; break;
      }

      var dimensionMap = { EI: ["E", "I"], SN: ["S", "N"], TF: ["T", "F"], JP: ["J", "P"] };
      var firstLetter = dimensionMap[dimensionPair][0];
      var secondLetter = dimensionMap[dimensionPair][1];
      var dimension = direction === "positive" ? firstLetter : secondLetter;
      answers[questionId] = { score: rawScore, dimension: dimension };
    }

    function showResult() {
      var type = calculatePersonalityType();
      var lang = document.documentElement.lang === "en" ? "en" : "zh";
      window.location.href = "/" + lang + "/psychoanalytic/mbti-test/result?type=" + type;
    }

    prevBtn.addEventListener("click", function () {
      if (currentQuestion > 0) {
        currentQuestion--;
        showQuestion(currentQuestion);
      }
    });

    nextBtn.addEventListener("click", function () {
      var currentCard = document.querySelector(".question-card:not(.hidden)");
      if (!currentCard) return;
      var currentQuestionId = parseInt(currentCard.getAttribute("data-question-id") || "0") - 1;

      if (!answers[currentQuestionId]) {
        var lang = document.documentElement.lang === "en" ? "en" : "zh";
        alert(lang === "en" ? "Please select an option" : "请选择一个选项");
        return;
      }

      if (currentQuestion < totalQuestions - 1) {
        currentQuestion++;
        showQuestion(currentQuestion);
      } else {
        var answeredQuestions = Object.keys(answers).length;
        if (answeredQuestions < totalQuestions) {
          var lang = document.documentElement.lang === "en" ? "en" : "zh";
          alert(lang === "en" ? "Please answer all questions (" + answeredQuestions + "/" + totalQuestions + ")" : "请回答所有问题（" + answeredQuestions + "/" + totalQuestions + "）");
          return;
        }
        showResult();
      }
    });
  }

  if (!window.__mbtiTestInitialized) {
    window.__mbtiTestInitialized = true;
    document.addEventListener("astro:page-load", initMbtiTest);
  }
</script>
