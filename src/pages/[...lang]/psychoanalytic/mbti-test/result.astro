---
import Base from "@/layouts/Base.astro";
import { getLangFromUrl } from "@/lib/utils/languageParser";
import { supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang === "zh" ? undefined : lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
---

<Base title={lang === "en" ? "MBTI Test Result" : "MBTI 测试结果"} lang={lang}>
  <section class="section-sm">
    <div class="container">
      <div id="result-container" class="mx-auto max-w-4xl">
        <p class="eyebrow">{lang === "en" ? "Psychoanalytic / Result" : "心理分析 / 测试结果"}</p>

        <div class="mt-5 border-b border-line pb-8">
          <h1
            id="type-result"
            class="tech-num text-[clamp(48px,9vw,84px)] font-semibold leading-none tracking-[-0.04em] text-ink"
          ></h1>
          <p id="type-description" class="mt-5 max-w-[640px] text-[16px] leading-[1.75] text-ink-sub"></p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-md border border-line p-5">
            <h3 class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">主导功能 · Dominant</h3>
            <p id="dominant-function" class="mt-3 text-[16px] font-medium text-ink"></p>
          </div>
          <div class="rounded-md border border-line p-5">
            <h3 class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">辅助功能 · Auxiliary</h3>
            <p id="auxiliary-function" class="mt-3 text-[16px] font-medium text-ink"></p>
          </div>
          <div class="rounded-md border border-line p-5">
            <h3 class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">第三功能 · Tertiary</h3>
            <p id="tertiary-function" class="mt-3 text-[16px] font-medium text-ink"></p>
          </div>
          <div class="rounded-md border border-line p-5">
            <h3 class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">劣势功能 · Inferior</h3>
            <p id="inferior-function" class="mt-3 text-[16px] font-medium text-ink"></p>
          </div>
        </div>

        <div class="mt-12 border-t border-line pt-8">
          <h2 class="text-[20px] font-semibold tracking-[-0.02em] text-ink">
            {lang === "en" ? "Strengths" : "优势"}
          </h2>
          <ul id="strengths-list" class="mt-5 grid grid-cols-1 gap-x-8 gap-y-0 md:grid-cols-2"></ul>
        </div>

        <div class="mt-12 border-t border-line pt-8">
          <h2 class="text-[20px] font-semibold tracking-[-0.02em] text-ink">
            {lang === "en" ? "Growth Areas" : "发展领域"}
          </h2>
          <ul id="weaknesses-list" class="mt-5 grid grid-cols-1 gap-x-8 gap-y-0 md:grid-cols-2"></ul>
        </div>

        <div class="mt-12 border-t border-line pt-8">
          <h2 class="text-[20px] font-semibold tracking-[-0.02em] text-ink">
            {lang === "en" ? "Career Suggestions" : "职业建议"}
          </h2>
          <div id="career-suggestions" class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2"></div>
        </div>

        <div class="mt-12 border-t border-line pt-8">
          <h2 class="text-[20px] font-semibold tracking-[-0.02em] text-ink">
            {lang === "en" ? "Development" : "发展建议"}
          </h2>
          <div id="development-areas" class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2"></div>
        </div>

        <div class="mt-12 border-t border-line pt-8">
          <h2 class="text-[20px] font-semibold tracking-[-0.02em] text-ink">
            {lang === "en" ? "Relationships" : "人际关系"}
          </h2>
          <div class="mt-5 grid grid-cols-1 gap-8 md:grid-cols-2">
            <div>
              <h3 class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">
                {lang === "en" ? "Strengths" : "优势"}
              </h3>
              <ul id="relationship-strengths" class="mt-3"></ul>
            </div>
            <div>
              <h3 class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">
                {lang === "en" ? "Challenges" : "挑战"}
              </h3>
              <ul id="relationship-challenges" class="mt-3"></ul>
            </div>
          </div>
        </div>

        <div class="mt-12 border-t border-line pt-8">
          <h2 class="text-[20px] font-semibold tracking-[-0.02em] text-ink">
            {lang === "en" ? "Work Style" : "工作风格"}
          </h2>
          <div class="mt-5 grid grid-cols-1 gap-8 md:grid-cols-2">
            <div>
              <h3 class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">
                {lang === "en" ? "Strengths" : "优势"}
              </h3>
              <ul id="work-strengths" class="mt-3"></ul>
            </div>
            <div>
              <h3 class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">
                {lang === "en" ? "Challenges" : "挑战"}
              </h3>
              <ul id="work-challenges" class="mt-3"></ul>
            </div>
          </div>
        </div>

        <div class="mt-14 flex flex-wrap gap-3 border-t border-line pt-8">
          <a href={`/${lang}/psychoanalytic/mbti-test`} class="btn btn-primary btn-lg">
            {lang === "en" ? "Retake Test" : "重新测试"}
          </a>
          <a href={`/${lang}/psychoanalytic`} class="btn btn-outline-primary btn-lg">
            {lang === "en" ? "Back to Overview" : "返回心理分析"}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { analyzeType } from "@/lib/mbti-analysis";

  const validMBTITypes = [
    "ISTJ","ISFJ","INFJ","INTJ","ISTP","ISFP","INFP","INTP",
    "ESTP","ESFP","ENFP","ENTP","ESTJ","ESFJ","ENFJ","ENTJ"
  ];

  const rowClass =
    "flex items-start gap-3 border-b border-line py-3 text-[14px] leading-[1.65] text-ink-sub";
  const tileClass =
    "flex items-start gap-3 rounded-sm border border-line p-4 text-[14px] leading-[1.6] text-ink-sub";

  function getMBTITypeFromURL(): string | null {
    const params = new URLSearchParams(window.location.search);
    const type = params.get("type");
    if (!type || !validMBTITypes.includes(type.toUpperCase())) return null;
    return type.toUpperCase();
  }

  function checkValidSource() {
    const type = getMBTITypeFromURL();
    if (!type) window.location.href = `/${document.documentElement.lang === "en" ? "en" : "zh"}/psychoanalytic/mbti-test`;
  }

  function showResult(type: string) {
    const analysis = analyzeType(type);
    if (!analysis) { console.error("Cannot analyze type:", type); return; }

    document.getElementById("type-result")!.textContent = analysis.type;
    document.getElementById("type-description")!.textContent = analysis.description;

    const checkIcon = `<svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-ink-muted" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>`;
    const dashIcon = `<svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-ink-muted" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"></path></svg>`;
    const arrowIcon = `<svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-ink-muted" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12h13M13 7l5 5-5 5"></path></svg>`;

    const fillList = (id: string, items: string[], icon: string) => {
      const el = document.getElementById(id)!;
      el.innerHTML = "";
      items.forEach((item: string) => {
        const li = document.createElement("li");
        li.className = rowClass;
        li.innerHTML = `${icon}<span>${item}</span>`;
        el.appendChild(li);
      });
    };

    const fillTiles = (id: string, items: string[], icon: string) => {
      const el = document.getElementById(id)!;
      el.innerHTML = "";
      items.forEach((item: string) => {
        const div = document.createElement("div");
        div.className = tileClass;
        div.innerHTML = `${icon}<span>${item}</span>`;
        el.appendChild(div);
      });
    };

    fillList("strengths-list", analysis.strengths, checkIcon);
    fillList("weaknesses-list", analysis.weaknesses, dashIcon);
    fillTiles("career-suggestions", analysis.careerSuggestions, arrowIcon);
    fillTiles("development-areas", analysis.developmentAreas, arrowIcon);

    (document.getElementById("dominant-function") as HTMLElement).textContent = analysis.cognitiveFunctions.dominant;
    (document.getElementById("auxiliary-function") as HTMLElement).textContent = analysis.cognitiveFunctions.auxiliary;
    (document.getElementById("tertiary-function") as HTMLElement).textContent = analysis.cognitiveFunctions.tertiary;
    (document.getElementById("inferior-function") as HTMLElement).textContent = analysis.cognitiveFunctions.inferior;

    fillList("relationship-strengths", analysis.relationshipStrengths, checkIcon);
    fillList("relationship-challenges", analysis.relationshipChallenges, dashIcon);
    fillList("work-strengths", analysis.workStyleStrengths, checkIcon);
    fillList("work-challenges", analysis.workStyleChallenges, dashIcon);
  }

  document.addEventListener("astro:page-load", () => {
    if ((window as any)._mbtiResultLoaded) return;
    (window as any)._mbtiResultLoaded = true;

    checkValidSource();
    const type = getMBTITypeFromURL();
    if (type) showResult(type);
    else window.location.href = `/${document.documentElement.lang === "en" ? "en" : "zh"}/psychoanalytic/mbti-test`;
  });
</script>
