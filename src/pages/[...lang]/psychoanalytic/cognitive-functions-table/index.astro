---
import CanvasScene from "@/components/canvas/CanvasScene.astro";
import Base from "@/layouts/Base.astro";
import { getLangFromUrl } from "@/lib/utils/languageParser";
import { supportedLang } from "@/lib/utils/languageParser";
import MBTITable from "@/layouts/components/MbtiTable";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang === "zh" ? undefined : lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
---

<Base title={lang === "en" ? "Cognitive Functions & I-Ching" : "认知功能与易经"} lang={lang}>
  <section class="section-sm">
    <div class="container">
      <div class="mx-auto flex max-w-4xl items-start justify-between gap-8">
        <div>
          <p class="kicker">{lang === "en" ? "Psychoanalytic / Cognitive Functions" : "心理分析 / 认知功能"}</p>
          <h1 class="mt-4 text-[clamp(26px,3.6vw,40px)] font-medium leading-[1.18] tracking-[-0.02em] text-ink-strong">
            {lang === "en" ? "MBTI Cognitive Functions & I-Ching Hexagrams" : "MBTI 认知功能与易经卦象"}
          </h1>
          <p class="mt-4 max-w-[640px] text-[15px] leading-[1.75] text-ink-sub">
            {lang === "en"
              ? "Explore the mapping between Jungian cognitive functions and I-Ching hexagrams"
              : "探索荣格认知功能与易经卦象的对应关系"}
          </p>
        </div>
        <CanvasScene scene="stepped" plain class="hidden aspect-square w-[240px] shrink-0 sm:block" />
      </div>

      <div class="mt-10 border-t border-line pt-10">
        <MBTITable client:only="react" />
      </div>
    </div>
  </section>
</Base>
