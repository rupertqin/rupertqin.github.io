---
import Button from "@/components/Button.astro";
import CanvasScene from "@/components/canvas/CanvasScene.astro";
import Base from "@/layouts/Base.astro";
import { getGraphic } from "@/lib/canvas/catalog";
import { getLangFromUrl } from "@/lib/utils/languageParser";
import { supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang === "zh" ? undefined : lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const isEn = lang === "en";

const capabilities = isEn
  ? [
      { name: "AI Analysis", note: "Models" },
      { name: "Psychoanalysis", note: "Personality" },
      { name: "Stock Analysis", note: "Markets" },
      { name: "Blog", note: "Notes" },
      { name: "Data Viz", note: "Charts" },
      { name: "Consulting", note: "Advisory" },
    ]
  : [
      { name: "AI分析", note: "模型" },
      { name: "精神分析助手", note: "人格" },
      { name: "股票分析", note: "行情" },
      { name: "博客", note: "笔记" },
      { name: "数据可视化", note: "图表" },
      { name: "企业咨询", note: "顾问" },
    ];

const features = isEn
  ? [
      {
        title: "Artificial Intelligence",
        desc: "Advanced AI solutions including machine learning, deep learning and NLP.",
      },
      {
        title: "Psychoanalysis Assistant",
        desc: "An AI-powered tool that pairs Jungian psychology with modern technology to deliver deep insight into personality.",
      },
      {
        title: "Tech Consulting",
        desc: "Professional technical consulting that empowers enterprise digital transformation.",
      },
    ]
  : [
      {
        title: "人工智能",
        desc: "提供先进的 AI 解决方案，包括机器学习、深度学习和自然语言处理。",
      },
      {
        title: "精神分析助手",
        desc: "AI 赋能的精神分析工具，结合荣格心理学与现代技术，提供深度人格洞察。",
      },
      {
        title: "技术咨询",
        desc: "为企业提供专业的技术咨询服务，助力数字化转型。",
      },
    ];

const stockPoints = isEn
  ? [
      {
        title: "Smart Trend Prediction",
        desc: "Use ML to analyse historical data and market sentiment, then forecast direction.",
      },
      {
        title: "Personalised Portfolio",
        desc: "Filter quality names automatically against your risk profile and goals.",
      },
      {
        title: "Real-time Risk Alert",
        desc: "Continuous portfolio risk assessment with allocation advice.",
      },
    ]
  : [
      {
        title: "智能趋势预测与分析",
        desc: "利用机器学习算法分析历史数据和市场情绪，预测股票未来走势。",
      },
      {
        title: "个性化投资组合建议",
        desc: "根据用户风险偏好和投资目标，自动筛选符合条件的优质股票。",
      },
      {
        title: "实时风险评估与预警",
        desc: "全面评估投资组合风险，提供风险预警和资产配置建议。",
      },
    ];

const testimonials = isEn
  ? [
      {
        quote:
          "Qinxiang's AI analysis tool improved our decision efficiency by 30%. Truly data-driven management.",
        author: "Zhang",
        role: "CEO / Tech Company",
      },
      {
        quote:
          "The stock trend analysis accuracy is amazing. It's now a key reference for my investments.",
        author: "Mr. Li",
        role: "Senior Investor",
      },
      {
        quote:
          "The blog has rich content and unique insights, providing valuable tech and business perspectives.",
        author: "Manager Wang",
        role: "Firm Director",
      },
    ]
  : [
      {
        quote:
          "秦项科技的 AI 分析工具帮助我们提高了 30% 的决策效率，真正实现了数据驱动的管理。",
        author: "张总",
        role: "某科技公司 CEO",
      },
      {
        quote:
          "股票趋势分析系统的预测准确率令人惊讶，已经成为我投资决策的重要参考。",
        author: "李先生",
        role: "资深投资者",
      },
      {
        quote:
          "博客内容丰富、观点独到，为我们提供了很多有价值的技术和商业洞察。",
        author: "王经理",
        role: "某事务所负责人",
      },
    ];

const specRows = isEn
  ? [
      ["Latency", "Real-time"],
      ["Intelligence", "Level 9"],
      ["Modules", "06"],
      ["Delivery", "API · Web"],
    ]
  : [
      ["响应速度", "实时"],
      ["智能程度", "L9"],
      ["服务模块", "06"],
      ["交付方式", "API · Web"],
    ];

const figures = [
  getGraphic("slices"),
  getGraphic("gauge"),
  getGraphic("orbit"),
];
---

<Base title={isEn ? "Qinxiang Tech - Leader in Tech Innovation" : "秦项科技 - 科技创新的引领者"} lang={lang}>
  <!-- Hero -->
  <section class="border-b border-line">
    <div class="container py-16 md:py-24">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">{isEn ? "Qinxiang · AI Solutions" : "秦项科技 · 智能解决方案"}</p>
          <h1 class="mt-6 text-[clamp(34px,5vw,56px)] font-semibold leading-[1.08] tracking-[-0.035em] text-ink">
            {isEn ? "One-Stop Enterprise" : "一站式企业"}
            <br />
            {isEn ? "AI Solutions" : "智能解决方案"}
          </h1>
          <p class="mt-7 max-w-[560px] text-[17px] leading-[1.75] text-ink-sub">
            {isEn
              ? "Simple, efficient and affordable. Integrate AI, data analytics and professional services to empower enterprise digital transformation."
              : "简单、高效且经济实惠。整合人工智能、数据分析和专业服务，助力企业数字化转型。"}
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <Button variant="default" size="lg">{isEn ? "Free Trial" : "免费试用"}</Button>
            <Button variant="outline" size="lg">{isEn ? "Book Demo" : "预约演示"}</Button>
          </div>
        </div>

        <!-- Spec panel -->
        <div class="lg:col-span-5">
          <div class="callout">
            <div class="flex items-center justify-between border-b border-line pb-4">
              <span class="eyebrow">{isEn ? "System / Overview" : "SYSTEM / 能力矩阵"}</span>
              <span class="eyebrow">v6.1</span>
            </div>
            <dl class="mt-2">
              {specRows.map(([k, v]) => (
                <div class="tech-kv">
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
            <div class="mt-5 flex items-center gap-2">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-ink-strong"></span>
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-muted">
                {isEn ? "All systems operational" : "服务运行正常"}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities strip -->
  <section class="border-b border-line">
    <div class="container">
      <div class="grid grid-cols-2 divide-y divide-line sm:grid-cols-3 lg:grid-cols-6 lg:divide-y-0 lg:divide-x">
        {capabilities.map((item, i) => (
          <div class="flex items-baseline justify-between gap-2 py-5 pr-5 sm:pr-0 lg:px-5 lg:first:pl-0 lg:last:pr-0">
            <div>
              <p class="text-[14px] font-medium text-ink">{item.name}</p>
              <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-ink-muted">{item.note}</p>
            </div>
            <span class="font-mono text-[10px] text-ink-muted">{String(i + 1).padStart(2, "0")}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Figures -->
  <section class="border-b border-line">
    <div class="container py-14 md:py-16">
      <p class="eyebrow">{isEn ? "Figures / System" : "图形 / 系统"}</p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {figures.map((figure) => (
          <figure>
            <CanvasScene scene={figure.key} class="aspect-square w-full" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="border-b border-line">
    <div class="container py-16 md:py-24">
      <div class="tech-section-head flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">{isEn ? "Capabilities" : "核心能力"}</p>
          <h2 class="mt-4 text-[clamp(24px,3vw,32px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
            {isEn ? "All-in-One Solution" : "一体化解决方案"}
          </h2>
        </div>
        <p class="max-w-[380px] text-[14px] leading-[1.7] text-ink-muted">
          {isEn
            ? "Three product lines share one delivery pipeline: research, modelling and advisory."
            : "三条产品线共用同一套交付管线：研究、建模与顾问服务。"}
        </p>
      </div>

      <div class="tech-grid">
        {features.map((feature, i) => (
          <div class="tech-feature">
            <span class="tech-feature-index">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="tech-feature-title">{feature.title}</h3>
            <p class="mt-3 text-[15px] leading-[1.7] text-ink-sub">{feature.desc}</p>
            <a href="#" class="tech-link mt-6 text-[13px] font-medium">
              {isEn ? "Learn More" : "了解更多"}
              <svg class="ml-1 h-3 w-3" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 8h11M9.5 4l4 4-4 4" />
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stock analysis -->
  <section class="border-b border-line">
    <div class="container py-16 md:py-24">
      <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <p class="eyebrow">{isEn ? "Quant / Research" : "量化 / 研究"}</p>
          <h2 class="mt-4 text-[clamp(24px,3vw,32px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
            {isEn ? "AI Stock Trend Analysis" : "智能股票趋势分析"}
          </h2>
          <p class="mt-5 max-w-[540px] text-[16px] leading-[1.75] text-ink-sub">
            {isEn
              ? "Our AI-driven stock analysis system helps investors make smarter decisions. Predict market trends and identify opportunities through deep learning and big data analytics."
              : "我们的 AI 驱动股票分析系统能够帮助投资者做出更明智的决策。通过深度学习和大数据分析，预测市场趋势，识别投资机会。"}
          </p>

          <ul class="mt-10 border-t border-line">
            {stockPoints.map((point, i) => (
              <li class="flex gap-4 border-b border-line py-5">
                <span class="mt-0.5 font-mono text-[10px] leading-none text-ink-muted">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="text-[15px] font-semibold text-ink">{point.title}</h3>
                  <p class="mt-1.5 text-[14px] leading-[1.65] text-ink-sub">{point.desc}</p>
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={isEn ? "/en/stock" : "/stock"} variant="default">
              {isEn ? "Learn More" : "了解更多"}
            </Button>
            <Button variant="outline">{isEn ? "Free Trial" : "免费试用"}</Button>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="tech-card p-6">
            <div class="flex items-center justify-between border-b border-line pb-4">
              <span class="eyebrow">{isEn ? "Model / Snapshot" : "MODEL / 指标快照"}</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-muted">2026</span>
            </div>
            <div class="border-b border-line bg-white">
              <CanvasScene scene="wave" plain class="h-[180px] w-full" />
            </div>
            <div class="grid grid-cols-2 gap-6 pt-6">
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">
                  {isEn ? "Accuracy" : "预测准确率"}
                </p>
                <p class="tech-num mt-2 text-[30px] font-semibold leading-none text-ink">85%</p>
              </div>
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">
                  {isEn ? "Return Boost" : "用户收益提升"}
                </p>
                <p class="tech-num mt-2 text-[30px] font-semibold leading-none text-ink">32%</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section>
    <div class="container py-16 md:py-24">
      <div class="tech-section-head">
        <p class="eyebrow">{isEn ? "References" : "客户反馈"}</p>
        <h2 class="mt-4 text-[clamp(24px,3vw,32px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
          {isEn ? "Client Reviews" : "客户评价"}
        </h2>
      </div>

      <div class="grid gap-10 md:grid-cols-3 md:gap-8">
        {testimonials.map((item) => (
          <figure class="tech-quote">
            <blockquote class="text-[15px] leading-[1.75] text-ink-sub">{item.quote}</blockquote>
            <figcaption class="mt-5">
              <p class="text-[14px] font-medium text-ink">{item.author}</p>
              <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.12em] text-ink-muted">{item.role}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="tech-band">
    <div class="container py-16 md:py-20">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">{isEn ? "Get Started" : "开始合作"}</p>
          <h2 class="mt-4 text-[clamp(24px,3vw,34px)] font-semibold leading-tight tracking-[-0.03em] text-ink">
            {isEn ? "Ready to Get Started?" : "准备好开始了吗？"}
          </h2>
          <p class="mt-4 max-w-[520px] text-[16px] leading-[1.75] text-ink-sub">
            {isEn
              ? "Experience our smart solutions now and boost your business efficiency and decision-making."
              : "立即体验我们的智能解决方案，提升您的业务效率和决策能力。"}
          </p>
        </div>
        <div class="flex items-end gap-8">
          <CanvasScene
            scene="concentric"
            plain
            class="hidden aspect-square w-[180px] shrink-0 sm:block"
          />
          <div class="flex flex-wrap gap-3">
            <Button variant="default" size="lg">{isEn ? "Free Trial" : "免费试用"}</Button>
            <Button variant="outline" size="lg">{isEn ? "Contact Sales" : "联系销售"}</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
