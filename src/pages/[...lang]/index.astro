---
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import Base from "@/layouts/Base.astro";
import { getLangFromUrl } from "@/lib/utils/languageParser";
import { supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang === "zh" ? undefined : lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const isEn = lang === "en";
---

<Base title={isEn ? "Qinxiang Tech - Leader in Tech Innovation" : "秦项科技 - 科技创新的引领者"} lang={lang}>
  <main>
    <!-- Hero Section -->
    <section class="pt-20 pb-12 md:pt-28 md:pb-20 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-900 dark:to-blue-900/20 overflow-hidden">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex flex-col md:flex-row items-center md:gap-8 lg:gap-12 min-h-[calc(92vh-4rem)] md:min-h-[70vh]">
          <div class="md:w-1/2 mb-8 md:mb-0 text-center md:text-left mx-auto md:mx-0 mt-8 md:mt-0">
            <h1 class="text-4xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 md:mb-6 leading-tight">
              <span>{isEn ? "One-Stop Enterprise" : "一站式企业"}</span>
              <br />
              <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">
                {isEn ? "AI Solutions" : "智能解决方案"}
              </span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 mb-6 md:mb-8 max-w-lg mx-auto md:mx-0">
              {isEn
                ? "Simple, efficient and affordable! Integrate AI, data analytics and professional services to empower enterprise digital transformation."
                : "简单、高效且经济实惠！整合人工智能、数据分析和专业服务，助力企业数字化转型。"}
            </p>
            <div class="flex gap-4 justify-center md:justify-start">
              <Button variant="default" size="lg">{isEn ? "Free Trial" : "免费试用"}</Button>
              <Button variant="outline" size="lg">{isEn ? "Book Demo" : "预约演示"}</Button>
            </div>
          </div>
          <div class="md:w-1/2 w-full mt-16 md:mt-8">
            <div class="relative md:p-4 flex justify-center md:block">
              <div class="absolute -top-8 -left-6 w-48 h-48 bg-blue-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob"></div>
              <div class="absolute -bottom-8 -right-8 w-48 h-48 bg-purple-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-2000"></div>

              <!-- Gantz inspired sphere -->
              <div class="relative flex items-center justify-center h-64 md:h-96 mt-2 mb-4">
                <div class="gantz-sphere w-60 h-60 md:w-80 md:h-80 rounded-full bg-gradient-to-br from-gray-600 to-gray-800 shadow-[inset_0_0_40px_rgba(0,100,255,0.4)] relative overflow-hidden">
                  <!-- Reflective highlights -->
                  <div class="absolute top-5 md:top-6 left-10 md:left-12 w-20 md:w-24 h-8 md:h-10 bg-blue-200 rounded-full opacity-20 rotate-[-30deg]"></div>
                  <div class="absolute top-16 md:top-20 left-12 md:left-16 w-10 md:w-12 h-3 md:h-4 bg-blue-200 rounded-full opacity-10 rotate-[-30deg]"></div>

                  <!-- Glowing rim -->
                  <div class="absolute inset-0 rounded-full border-2 border-blue-400 opacity-40 glow-effect"></div>

                  <!-- Interface dots -->
                  <div class="absolute top-1/4 right-1/4 w-2.5 md:w-3 h-2.5 md:h-3 bg-blue-400 rounded-full pulse-dot"></div>
                  <div class="absolute bottom-1/3 left-1/3 w-2.5 md:w-3 h-2.5 md:h-3 bg-blue-400 rounded-full pulse-dot animation-delay-500"></div>
                  <div class="absolute top-1/2 right-1/3 w-2.5 md:w-3 h-2.5 md:h-3 bg-blue-400 rounded-full pulse-dot animation-delay-1000"></div>
                  <div class="absolute top-1/3 right-1/2 w-1.5 md:w-2 h-1.5 md:h-2 bg-purple-400 rounded-full pulse-dot animation-delay-1500"></div>
                  <div class="absolute bottom-1/4 right-1/4 w-1.5 md:w-2 h-1.5 md:h-2 bg-purple-400 rounded-full pulse-dot animation-delay-2000"></div>

                  <!-- Futuristic circular interface -->
                  <div class="absolute inset-5 md:inset-6 rounded-full border border-blue-500/30"></div>
                  <div class="absolute inset-10 md:inset-12 rounded-full border border-blue-500/20"></div>
                  <div class="absolute inset-15 md:inset-18 rounded-full border border-blue-500/10"></div>

                  <!-- Central core effect -->
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-12 md:w-16 h-12 md:h-16 rounded-full bg-blue-900/20 flex items-center justify-center pulse-core">
                      <div class="w-6 md:w-8 h-6 md:h-8 rounded-full bg-blue-400/30"></div>
                    </div>
                  </div>
                </div>

                <!-- Data metrics around the sphere -->
                <div class="absolute -top-8 -right-4 bg-white dark:bg-gray-800 p-2 rounded-lg shadow-md">
                  <p class="text-xs font-medium text-gray-500 dark:text-gray-400">{isEn ? "Response" : "响应速度"}</p>
                  <p class="text-base font-bold text-blue-600">{isEn ? "Real-time" : "实时"}</p>
                </div>

                <div class="absolute -bottom-6 -left-4 bg-white dark:bg-gray-800 p-2 rounded-lg shadow-md">
                  <p class="text-xs font-medium text-gray-500 dark:text-gray-400">{isEn ? "Intelligence" : "智能程度"}</p>
                  <p class="text-base font-bold text-purple-600">Level 9</p>
                </div>

                <!-- Technical circles -->
                <div class="absolute -left-14 top-1/2 transform -translate-y-1/2 hidden md:block">
                  <div class="w-16 h-2 bg-blue-400/20 rounded-full mb-2"></div>
                  <div class="w-12 h-2 bg-blue-500/20 rounded-full mb-2"></div>
                  <div class="w-14 h-2 bg-blue-600/20 rounded-full"></div>
                </div>

                <div class="absolute -right-14 top-1/2 transform -translate-y-1/2 hidden md:block">
                  <div class="w-16 h-2 bg-purple-400/20 rounded-full mb-2"></div>
                  <div class="w-12 h-2 bg-purple-500/20 rounded-full mb-2"></div>
                  <div class="w-14 h-2 bg-purple-600/20 rounded-full"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- App Icons Section -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="container mx-auto px-4 text-center">
        <div class="flex flex-wrap justify-center gap-8 md:gap-12">
          {[
            { name: isEn ? "AI Analysis" : "AI分析", icon: "🧠" },
            { name: isEn ? "Psychoanalysis" : "精神分析助手", icon: "🔍" },
            { name: isEn ? "Stock Analysis" : "股票分析", icon: "📈" },
            { name: isEn ? "Blog" : "博客", icon: "📝" },
            { name: isEn ? "Data Viz" : "数据可视化", icon: "📊" },
            { name: isEn ? "Consulting" : "企业咨询", icon: "💼" }
          ].map(app => (
            <div class="flex flex-col items-center">
              <div class="w-16 h-16 flex items-center justify-center text-3xl bg-gray-100 dark:bg-gray-800 rounded-full mb-3">{app.icon}</div>
              <span class="text-sm font-medium">{app.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="py-20 bg-gray-50 dark:bg-gray-800">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-16">{isEn ? "All-in-One Solution" : "一体化解决方案"}</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            {
              title: isEn ? "Artificial Intelligence" : "人工智能",
              desc: isEn ? "Advanced AI solutions including machine learning, deep learning and NLP." : "提供先进的AI解决方案，包括机器学习、深度学习和自然语言处理",
              icon: "🤖"
            },
            {
              title: isEn ? "Psychoanalysis Assistant" : "精神分析助手",
              desc: isEn ? "AI-powered psychoanalysis tool combining Jungian psychology with modern technology." : "AI赋能的精神分析工具，结合荣格心理学与现代技术，提供深度人格洞察",
              icon: "🧠"
            },
            {
              title: isEn ? "Tech Consulting" : "技术咨询",
              desc: isEn ? "Professional technical consulting to empower enterprise digital transformation." : "为企业提供专业的技术咨询服务，助力数字化转型",
              icon: "💡"
            }
          ].map(feature => (
            <div class="bg-white dark:bg-gray-900 p-8 rounded-lg shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col">
              <div class="text-4xl mb-4">{feature.icon}</div>
              <h3 class="text-xl font-semibold mb-4">{feature.title}</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-6">{feature.desc}</p>
              <a href="#" class="text-blue-600 dark:text-blue-400 mt-auto inline-flex items-center">
                {isEn ? "Learn More" : "了解更多"}
                <Icon name="arrow-right" class="w-4 h-4 ml-1" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stock Analysis Section -->
    <section class="py-20 bg-white dark:bg-gray-900">
      <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center gap-12">
          <div class="md:w-1/2">
            <h2 class="text-3xl font-bold mb-6">
              <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">
                {isEn ? "AI Stock Trend Analysis" : "智能股票趋势分析"}
              </span>
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-6">
              {isEn
                ? "Our AI-driven stock analysis system helps investors make smarter decisions. Predict market trends and identify opportunities through deep learning and big data analytics."
                : "我们的AI驱动股票分析系统能够帮助投资者做出更明智的决策。通过深度学习和大数据分析，预测市场趋势，识别投资机会。"}
            </p>
            <ul class="space-y-4 mb-8">
              <li class="flex items-start">
                <div class="flex-shrink-0 w-6 h-6 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mt-1">
                  <Icon name="checkmark" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
                </div>
                <div class="ml-3">
                  <h4 class="font-medium">{isEn ? "Smart Trend Prediction" : "智能趋势预测与分析"}</h4>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">{isEn ? "Use ML to analyze historical data and predict stock trends" : "利用机器学习算法分析历史数据和市场情绪，预测股票未来走势"}</p>
                </div>
              </li>
              <li class="flex items-start">
                <div class="flex-shrink-0 w-6 h-6 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mt-1">
                  <Icon name="checkmark" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
                </div>
                <div class="ml-3">
                  <h4 class="font-medium">{isEn ? "Personalized Portfolio" : "个性化投资组合建议"}</h4>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">{isEn ? "Auto-filter quality stocks based on risk preference" : "根据用户风险偏好和投资目标，自动筛选符合条件的优质股票"}</p>
                </div>
              </li>
              <li class="flex items-start">
                <div class="flex-shrink-0 w-6 h-6 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mt-1">
                  <Icon name="checkmark" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
                </div>
                <div class="ml-3">
                  <h4 class="font-medium">{isEn ? "Real-time Risk Alert" : "实时风险评估与预警"}</h4>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">{isEn ? "Comprehensive risk assessment and asset allocation advice" : "全面评估投资组合风险，提供风险预警和资产配置建议"}</p>
                </div>
              </li>
            </ul>
            <div class="flex gap-4">
              <a href={isEn ? "/en/stock" : "/stock"}>
                <Button variant="default">{isEn ? "Learn More" : "了解更多"}</Button>
              </a>
              <Button variant="outline">{isEn ? "Free Trial" : "免费试用"}</Button>
            </div>
          </div>
          <div class="md:w-1/2">
            <div class="bg-gray-50 dark:bg-gray-800 p-8 rounded-lg shadow-lg">
              <div class="aspect-video bg-white dark:bg-gray-900 rounded-md flex items-center justify-center mb-6">
                <img src="/images/icons/chart.svg" alt="Chart" class="w-24 h-24 text-blue-500 opacity-80 chart-icon" />
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-white dark:bg-gray-900 p-4 rounded-md">
                  <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">{isEn ? "Accuracy" : "预测准确率"}</p>
                  <p class="text-3xl font-bold text-blue-600 dark:text-blue-400">85%</p>
                </div>
                <div class="bg-white dark:bg-gray-900 p-4 rounded-md">
                  <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">{isEn ? "Return Boost" : "用户收益提升"}</p>
                  <p class="text-3xl font-bold text-purple-600 dark:text-purple-400">32%</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="py-20 bg-gray-50 dark:bg-gray-800">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-16">{isEn ? "Client Reviews" : "客户评价"}</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            {
              quote: isEn ? "Qinxiang's AI analysis tool improved our decision efficiency by 30%. Truly data-driven management." : "秦项科技的AI分析工具帮助我们提高了30%的决策效率，真正实现了数据驱动的管理。",
              author: isEn ? "Zhang" : "张总",
              company: isEn ? "Tech Company CEO" : "某科技公司 CEO"
            },
            {
              quote: isEn ? "The stock trend analysis accuracy is amazing. It's now a key reference for my investments." : "股票趋势分析系统的预测准确率令人惊讶，已经成为我投资决策的重要参考。",
              author: isEn ? "Mr. Li" : "李先生",
              company: isEn ? "Senior Investor" : "资深投资者"
            },
            {
              quote: isEn ? "The blog has rich content and unique insights, providing valuable tech and business perspectives." : "博客内容丰富、观点独到，为我们提供了很多有价值的技术和商业洞察。",
              author: isEn ? "Manager Wang" : "王经理",
              company: isEn ? "Firm Director" : "某事务所负责人"
            }
          ].map(testimonial => (
            <div class="bg-white dark:bg-gray-900 p-8 rounded-lg shadow-sm">
              <Icon name="quote" class="w-10 h-10 text-blue-200 dark:text-blue-800 mb-4" />
              <p class="text-gray-600 dark:text-gray-300 mb-6">{testimonial.quote}</p>
              <div>
                <p class="font-medium">{testimonial.author}</p>
                <p class="text-sm text-gray-500 dark:text-gray-400">{testimonial.company}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-blue-600 dark:bg-blue-800">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-white mb-6">{isEn ? "Ready to Get Started?" : "准备好开始了吗？"}</h2>
        <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
          {isEn ? "Experience our smart solutions now and boost your business efficiency and decision-making." : "立即体验我们的智能解决方案，提升您的业务效率和决策能力。"}
        </p>
        <div class="flex justify-center gap-4">
          <Button variant="white" size="lg">{isEn ? "Free Trial" : "免费试用"}</Button>
          <Button variant="outline-white" size="lg">{isEn ? "Contact Sales" : "联系销售"}</Button>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  @keyframes blob {
    0% { transform: scale(1); }
    33% { transform: scale(1.1); }
    66% { transform: scale(0.9); }
    100% { transform: scale(1); }
  }
  .animate-blob {
    animation: blob 7s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  .animation-delay-500 {
    animation-delay: 0.5s;
  }
  .animation-delay-1000 {
    animation-delay: 1s;
  }
  .animation-delay-1500 {
    animation-delay: 1.5s;
  }

  @keyframes pulse-dot {
    0% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
    100% { opacity: 0.4; transform: scale(1); }
  }
  .pulse-dot {
    animation: pulse-dot 3s infinite;
  }

  @keyframes pulse-core {
    0% { opacity: 0.6; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.05); }
    100% { opacity: 0.6; transform: scale(0.9); }
  }
  .pulse-core {
    animation: pulse-core 4s infinite;
  }

  @keyframes glow {
    0% { opacity: 0.2; }
    50% { opacity: 0.4; }
    100% { opacity: 0.2; }
  }
  .glow-effect {
    animation: glow 4s infinite;
  }

  .gantz-sphere {
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(2deg); }
    100% { transform: translateY(0px) rotate(0deg); }
  }

  /* Dark mode chart icon */
  @media (prefers-color-scheme: dark) {
    .chart-icon {
      filter: invert(1);
    }
  }
  .dark .chart-icon {
    filter: invert(1);
  }
</style>
