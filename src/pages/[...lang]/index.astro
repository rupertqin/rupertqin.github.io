---
import Button from "@/components/Button.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CanvasScene from "@/components/canvas/CanvasScene.astro";
import Base from "@/layouts/Base.astro";
import { getGraphic } from "@/lib/canvas/catalog";
import { getLangFromUrl, supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang === "zh" ? undefined : lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const isEn = lang === "en";

const features = isEn
  ? [
      {
        title: "Artificial Intelligence",
        desc: "Advanced AI solutions including machine learning, deep learning and NLP.",
      },
      {
        title: "Psychoanalysis Assistant",
        desc: "An AI-powered tool that pairs Jungian psychology with modern technology to deliver deep insight into personality.",
      },
      {
        title: "Tech Consulting",
        desc: "Professional technical consulting that empowers enterprise digital transformation.",
      },
    ]
  : [
      {
        title: "人工智能",
        desc: "提供先进的 AI 解决方案，包括机器学习、深度学习和自然语言处理。",
      },
      {
        title: "精神分析助手",
        desc: "AI 赋能的精神分析工具，结合荣格心理学与现代技术，提供深度人格洞察。",
      },
      {
        title: "技术咨询",
        desc: "为企业提供专业的技术咨询服务，助力数字化转型。",
      },
    ];

const stockPoints = isEn
  ? [
      {
        title: "Smart Trend Prediction",
        desc: "Use ML to analyse historical data and market sentiment, then forecast direction.",
      },
      {
        title: "Personalised Portfolio",
        desc: "Filter quality names automatically against your risk profile and goals.",
      },
      {
        title: "Real-time Risk Alert",
        desc: "Continuous portfolio risk assessment with allocation advice.",
      },
    ]
  : [
      {
        title: "智能趋势预测与分析",
        desc: "利用机器学习算法分析历史数据和市场情绪，预测股票未来走势。",
      },
      {
        title: "个性化投资组合建议",
        desc: "根据用户风险偏好和投资目标，自动筛选符合条件的优质股票。",
      },
      {
        title: "实时风险评估与预警",
        desc: "全面评估投资组合风险，提供风险预警和资产配置建议。",
      },
    ];

const testimonials = isEn
  ? [
      {
        quote:
          "Qinxiang's AI analysis tool improved our decision efficiency by 30%. Truly data-driven management.",
        author: "Zhang",
        role: "CEO / Tech Company",
      },
      {
        quote:
          "The stock trend analysis accuracy is amazing. It's now a key reference for my investments.",
        author: "Mr. Li",
        role: "Senior Investor",
      },
      {
        quote:
          "The blog has rich content and unique insights, providing valuable tech and business perspectives.",
        author: "Manager Wang",
        role: "Firm Director",
      },
    ]
  : [
      {
        quote:
          "秦项科技的 AI 分析工具帮助我们提高了 30% 的决策效率，真正实现了数据驱动的管理。",
        author: "张总",
        role: "某科技公司 CEO",
      },
      {
        quote:
          "股票趋势分析系统的预测准确率令人惊讶，已经成为我投资决策的重要参考。",
        author: "李先生",
        role: "资深投资者",
      },
      {
        quote:
          "博客内容丰富、观点独到，为我们提供了很多有价值的技术和商业洞察。",
        author: "王经理",
        role: "某事务所负责人",
      },
    ];

const figures = [
  { graphic: getGraphic("slices"), fig: "01" },
  { graphic: getGraphic("gauge"), fig: "02" },
  { graphic: getGraphic("orbit"), fig: "03" },
];

const heroGraphic = getGraphic("orbit");
---

<Base
  title={isEn ? "Qinxiang Tech - Leader in Tech Innovation" : "秦项科技 - 科技创新的引领者"}
  lang={lang}
>
  <!-- Hero -->
  <section class="band--first pb-16 md:pb-24">
    <div class="wrap">
      <p class="kicker">
        {isEn ? "Qinxiang · AI and technology" : "秦项科技 · 专注于人工智能与科技创新"}
      </p>

      <h1 class="display mt-6 max-w-[900px]">
        {isEn ? "One-stop enterprise" : "一站式企业"}
        <br />
        <span class="display__muted">{isEn ? "AI solutions" : "智能解决方案"}</span>
      </h1>

      <p class="lede mt-7 max-w-[560px]">
        {isEn
          ? "Simple, efficient and affordable. Integrate AI, data analytics and professional services to empower enterprise digital transformation."
          : "简单、高效且经济实惠。整合人工智能、数据分析和专业服务，助力企业数字化转型。"}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <Button variant="default" size="lg">{isEn ? "Free Trial" : "免费试用"}</Button>
        <Button variant="outline" size="lg" href={isEn ? "/en/contact" : "/contact"}>
          {isEn ? "Book Demo" : "预约演示"}
        </Button>
      </div>

      <figure class="mt-14 md:mt-20">
        <div class="media media--field grid aspect-[4/3] place-items-center sm:aspect-[16/8]">
          <CanvasScene
            scene={heroGraphic.key}
            plain
            class="media__art aspect-square w-[min(72%,520px)]"
          />
        </div>
        <figcaption class="media__note">
          <span>{isEn ? heroGraphic.en : heroGraphic.zh}</span>
          <span>{isEn ? "Line art, one weight, one grey" : "线稿 · 一种线宽 · 一种灰"}</span>
        </figcaption>
      </figure>

      <dl class="stat-row">
        {[
          ["06", isEn ? "Service modules" : "服务模块"],
          ["85%", isEn ? "Forecast accuracy" : "预测准确率"],
          ["32%", isEn ? "Return uplift" : "收益提升"],
        ].map(([value, label]) => (
          <div class="stat">
            <dd class="stat__value">{value}</dd>
            <dt class="stat__label">{label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 01 · Platform -->
  <section class="band">
    <div class="wrap">
      <SectionHeader
        index="01"
        eyebrow={isEn ? "Platform" : "平台"}
        title={isEn ? "All-in-one solution" : "一体化解决方案"}
        desc={isEn
          ? "Integrate AI, data analytics and professional services to empower enterprise digital transformation."
          : "整合人工智能、数据分析和专业服务，助力企业数字化转型。"}
      >
        <div class="feature-row">
          {features.map((feature) => (
            <div class="feature">
              <h3 class="feature__label">{feature.title}</h3>
              <p class="feature__text">{feature.desc}</p>
            </div>
          ))}
        </div>
      </SectionHeader>
    </div>
  </section>

  <!-- 02 · Stock -->
  <section class="band">
    <div class="wrap">
      <SectionHeader
        index="02"
        eyebrow={isEn ? "Quant" : "量化"}
        title={isEn ? "AI stock trend analysis" : "智能股票趋势分析"}
        desc={isEn
          ? "Our AI-driven stock analysis system helps investors make smarter decisions. Predict market trends and identify opportunities through deep learning and big data analytics."
          : "我们的 AI 驱动股票分析系统能够帮助投资者做出更明智的决策。通过深度学习和大数据分析，预测市场趋势，识别投资机会。"}
      >
        <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <ul class="border-t border-line">
              {stockPoints.map((point) => (
                <li class="border-b border-line py-5">
                  <h3 class="text-[15px] font-medium text-ink-strong">{point.title}</h3>
                  <p class="mt-1.5 text-[14px] leading-[1.65] text-ink-muted">{point.desc}</p>
                </li>
              ))}
            </ul>

            <a href={isEn ? "/en/stock" : "/stock"} class="arrow-link mt-8">
              {isEn ? "Learn more" : "了解更多"}
              <span class="arrow-link__arrow">→</span>
            </a>
          </div>

          <div>
            <div class="media media--field aspect-[16/10]">
              <CanvasScene scene="stepped" plain class="media__art absolute inset-0 h-full w-full" />
            </div>
            <div class="mt-6 grid grid-cols-2 gap-6 border-t border-line pt-6">
              <div>
                <p class="stat__value">85%</p>
                <p class="stat__label">{isEn ? "Forecast accuracy" : "预测准确率"}</p>
              </div>
              <div>
                <p class="stat__value">32%</p>
                <p class="stat__label">{isEn ? "Return uplift" : "用户收益提升"}</p>
              </div>
            </div>
          </div>
        </div>
      </SectionHeader>
    </div>
  </section>

  <!-- 03 · References -->
  <section class="band">
    <div class="wrap">
      <SectionHeader
        index="03"
        eyebrow={isEn ? "References" : "客户反馈"}
        title={isEn ? "What clients say" : "客户评价"}
      >
        <figure class="mt-12 max-w-[820px]">
          <blockquote class="quote">{testimonials[0].quote}</blockquote>
          <figcaption class="quote__by">
            {testimonials[0].author} · {testimonials[0].role}
          </figcaption>
        </figure>

        <div class="mt-12 grid gap-8 border-t border-line pt-8 md:grid-cols-2 md:gap-10">
          {testimonials.slice(1).map((item) => (
            <figure>
              <blockquote class="text-[15px] leading-[1.7] text-ink-sub">{item.quote}</blockquote>
              <figcaption class="quote__by">{item.author} · {item.role}</figcaption>
            </figure>
          ))}
        </div>
      </SectionHeader>
    </div>
  </section>

  <!-- 04 · Figures -->
  <section class="band">
    <div class="wrap">
      <SectionHeader
        index="04"
        eyebrow={isEn ? "Figures" : "图形"}
        title={isEn ? "Site figures" : "站点图形"}
        desc={isEn
          ? "Line art from the Polar open-source graphics library, drawn with one stroke weight and one grey."
          : "线条图形取自 POLAR 开源图形库，全站统一一种线宽、一种灰。"}
      >
        <div class="mt-12 grid gap-8 md:grid-cols-3 md:gap-6">
          {figures.map(({ graphic }) => (
            <figure>
              <div class="media media--field aspect-square">
                <CanvasScene
                  scene={graphic.key}
                  plain
                  class="media__art absolute inset-0 h-full w-full"
                />
              </div>
              <figcaption class="media__note">
                <span>{isEn ? graphic.en : graphic.zh}</span>
                <span>1:1</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </SectionHeader>
    </div>
  </section>

  <!-- CTA -->
  <section class="band">
    <div class="wrap">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div class="max-w-[620px]">
          <h2 class="headline">{isEn ? "Ready to get started?" : "准备好开始了吗？"}</h2>
          <p class="lede">
            {isEn
              ? "Experience our smart solutions now and boost your business efficiency and decision-making."
              : "立即体验我们的智能解决方案，提升您的业务效率和决策能力。"}
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <Button variant="default" size="lg" href={isEn ? "/en/contact" : "/contact"}>
            {isEn ? "Contact Sales" : "联系销售"}
          </Button>
          <Button variant="outline" size="lg" href={isEn ? "/en/blog" : "/blog"}>
            {isEn ? "Read the blog" : "读博客"}
          </Button>
        </div>
      </div>
    </div>
  </section>
</Base>
