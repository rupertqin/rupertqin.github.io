---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
  supportedLang,
} from "@/lib/utils/languageParser";


export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

let lang = getLangFromUrl(Astro.url);

const disabledLanguages = config.settings.disable_languages as string[];
if (disabledLanguages.includes(lang)) {
  lang = config.settings.default_language;
}

const { page_not_found_content, page_not_found, back_to_home } =
  await getTranslations(lang);
---

<Base title="Page Not Found">
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <p class="eyebrow mb-6">Error / 404</p>
          <span class="tech-num block text-[clamp(64px,12vw,120px)] font-semibold leading-none tracking-[-0.04em] text-line-strong">
            404
          </span>
          <h1 class="mt-8 text-[24px] font-semibold tracking-[-0.02em] text-ink">{page_not_found}</h1>
          <div class="content mt-4 max-w-[420px]">
            <p>{page_not_found_content}</p>
          </div>
          <a href={slugSelector("/", lang)} class="btn btn-primary mt-10"
            >{back_to_home}</a
          >
        </div>
      </div>
    </div>
  </section>
</Base>
