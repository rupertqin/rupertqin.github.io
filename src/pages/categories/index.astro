---
import Base from "@/layouts/Base.astro";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";

const BLOG_FOLDER = "blog";

const categories = await getTaxonomy(BLOG_FOLDER, "categories");
const allCategories = await getAllTaxonomy(BLOG_FOLDER, "categories");
---

<Base title={"Categories"}>
  <PageHeader title={"Categories"} eyebrow="Taxonomy" />
  <section class="section">
    <div class="wrap">
      <ul class="flex flex-wrap gap-2">
        {
          categories.map((category: string) => {
            const count = allCategories.filter((c) => c === category).length;
            return (
              <li>
                <a
                  href={`/categories/${category}`}
                  class="inline-flex items-baseline gap-2 rounded-full border border-line px-4 py-2 text-[14px] text-ink-sub transition-colors duration-200 hover:border-line-strong hover:text-ink-strong"
                >
                  {humanize(category)}{" "}
                  <span class="text-[12px] tabular-nums text-ink-muted">
                    {count}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>
